{% liquid
  assign help_modal_id = 'help-modal-' | append: section.id
%}

<div class="help-fab" data-help-fab>
  <button
    type="button"
    class="help-fab__button"
    aria-label="{{ 'accessibility.help_modal' | t }}"
    data-modal-trigger="{{ help_modal_id }}"
  >
    <span class="help-fab__icon">
      {{- 'icon-informacion.svg' | inline_asset_content -}}
    </span>
  </button>
</div>

<dialog
  id="{{ help_modal_id }}"
  class="help-modal"
  aria-modal="true"
  aria-labelledby="{{ help_modal_id }}-title"
>
  <div class="help-modal__inner">
    <header class="help-modal__header">
      <div class="help-modal__logo">
        {% if settings.logo != blank %}
          {{
            settings.logo
            | image_url: width: 200
            | image_tag: loading: 'lazy', class: 'help-modal__logo-image', alt: shop.name
          }}
        {% else %}
          <span class="help-modal__shop-name">{{ shop.name }}</span>
        {% endif %}
      </div>
      <button
        type="button"
        class="help-modal__close"
        aria-label="{{ 'accessibility.close' | t }}"
        data-modal-close
      >
        <span aria-hidden="true">&times;</span>
      </button>
    </header>

    <div class="help-modal__body">
      <h2 id="{{ help_modal_id }}-title" class="help-modal__title">
        {{ 'content.how_can_we_help' | t }}
      </h2>

      <div class="help-modal__buttons">
        <a
          href="https://wa.link/jhyooy"
          target="_blank"
          rel="noopener noreferrer"
          class="help-modal__button help-modal__button--whatsapp"
        >
          <span class="help-modal__button-icon">
            <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              {% render 'icon', icon: 'whatsapp' %}
            </svg>
          </span>
          <span class="help-modal__button-text">{{ 'content.write_whatsapp' | t }}</span>
        </a>

        <a
          href="/pages/ayuda-pqr"
          class="help-modal__button help-modal__button--pqr"
        >
          <span class="help-modal__button-icon">
            <svg viewBox="0 0 800 800" aria-hidden="true" focusable="false">
              {{- 'icon-cambios.svg' | inline_asset_content -}}
            </svg>
          </span>
          <span class="help-modal__button-text">{{ 'content.changes_pqr' | t }}</span>
        </a>
      </div>
    </div>
  </div>
</dialog>

{% javascript %}
  (function () {
    const fab = document.querySelector('[data-help-fab]');
    if (!fab) return;

    const trigger = fab.querySelector('[data-modal-trigger]');
    const modal = document.getElementById(trigger.dataset.modalTrigger);
    if (!modal) return;

    trigger.addEventListener('click', function () {
      modal.showModal();
      document.body.style.overflow = 'hidden';
    });

    const closeBtn = modal.querySelector('[data-modal-close]');
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        modal.close();
        document.body.style.overflow = '';
      });
    }

    modal.addEventListener('click', function (e) {
      if (e.target === modal) {
        modal.close();
        document.body.style.overflow = '';
      }
    });

    modal.addEventListener('close', function () {
      document.body.style.overflow = '';
    });
  })();
{% endjavascript %}

{% stylesheet %}
  .help-fab {
    position: fixed;
    bottom: var(--padding-lg, 16px);
    right: var(--padding-lg, 16px);
    z-index: var(--layer-sticky, 100);
  }

  .help-fab__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: #ffffff;
    color: #000000;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.15);
    transition: transform 0.2s var(--animation-easing), box-shadow 0.2s var(--animation-easing);
  }

  .help-fab__button:hover {
    transform: scale(1.05);
    box-shadow: 0 6px 16px rgb(0 0 0 / 0.2);
  }

  .help-fab__button:active {
    transform: scale(0.95);
  }

  .help-fab__icon {
    display: flex;
    width: 28px;
    height: 28px;
  }

  .help-fab__icon svg {
    width: 100%;
    height: 100%;
  }

  .help-modal {
    padding: 0;
    border: none;
    border-radius: var(--border-radius-lg, 12px);
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.25);
    background: var(--color-background, #fff);
    color: var(--color-foreground, #111);
    max-width: min(90vw, 520px);
    width: 100%;
    max-height: 90dvh;
    overflow: hidden;
  }

  .help-modal::backdrop {
    background: rgb(0 0 0 / 0.5);
  }

  .help-modal[open] {
    animation: helpModalIn var(--animation-speed, 0.3s) var(--animation-easing) forwards;
  }

  .help-modal.closing {
    animation: helpModalOut var(--animation-speed, 0.3s) var(--animation-easing) forwards;
  }

  @keyframes helpModalIn {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(10px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes helpModalOut {
    from {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    to {
      opacity: 0;
      transform: scale(0.95) translateY(10px);
    }
  }

  .help-modal__inner {
    display: flex;
    flex-direction: column;
  }

  .help-modal__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--padding-lg, 24px);
    border-bottom: 1px solid var(--color-border, #e6e6e6);
    position: relative;
  }

  .help-modal__logo {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .help-modal__logo-image {
    max-height: 48px;
    width: auto;
    object-fit: contain;
  }

  .help-modal__shop-name {
    font-size: var(--font-size--lg, 18px);
    font-weight: 600;
    font-family: var(--font-body--family);
  }

  .help-modal__close {
    position: absolute;
    top: var(--padding-md, 16px);
    right: var(--padding-md, 16px);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 24px;
    line-height: 1;
    color: var(--color-foreground, #111);
    transition: background-color 0.15s var(--animation-easing);
  }

  .help-modal__close:hover {
    background-color: rgb(0 0 0 / 0.05);
  }

  .help-modal__body {
    padding: var(--padding-xl, 24px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xl, 24px);
  }

  .help-modal__title {
    margin: 0;
    font-size: var(--font-size--lg, 18px);
    font-weight: 600;
    font-family: var(--font-heading--family);
    text-align: center;
    letter-spacing: 0.02em;
    color: var(--color-foreground-heading, var(--color-foreground, #111));
  }

  .help-modal__buttons {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md, 16px);
    width: 100%;
  }

  .help-modal__button {
    gap: 5px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: var(--padding-md, 16px) var(--padding-lg, 24px);
    border-radius: var(--border-radius-md, 8px);
    text-decoration: none;
    color: inherit;
    border: 1px solid #111;
    flex: 1;
    width: 100%;
    box-sizing: border-box;
  }

  .help-modal__button:hover {
    background-color: rgb(0 0 0 / 0.06);
  }

  .help-modal__button-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .help-modal__button-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .help-modal__button-icon img,
  .help-modal__button-icon object {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .help-modal__button-text {
    font-size: var(--font-size--sm, 14px);
    font-weight: 500;
    text-align: left;
    line-height: 1.4;
  }

  @media screen and (min-width: 750px) {
    .help-modal__buttons {
      flex-direction: row;
    }

    .help-modal__button {
      flex-direction: column;
      justify-content: center;
      text-align: center;
    }

    .help-modal__button-text {
      text-align: center;
    }
  }
{% endstylesheet %}

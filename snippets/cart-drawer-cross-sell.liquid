{%- doc -%}
  Renders a cross-sell component inside the cart drawer with accordion and horizontal carousel.

  @param {object} [block] - The block object containing settings.
  @param {string} [source] - Source for products: 'recommendations' or 'collection'. Defaults to 'recommendations'.
  @param {object} [collection] - Collection to show products from when source is 'collection'.
  @param {string} [recommendation_type] - Type of recommendations: 'complementary' or 'related'. Defaults to 'complementary'.
  @param {string} [heading] - Heading text for the accordion.
  @param {number} [max_products] - Maximum number of products to show. Defaults to 8.
{%- enddoc -%}

<script
  src="{{ 'cart-cross-sell.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign cross_sell_source = source | default: 'recommendations'
  assign cross_sell_collection = collection | default: collections.all
  assign cross_sell_recommendation_type = recommendation_type | default: 'complementary'
  assign cross_sell_max = max_products | default: 8
  assign cross_sell_heading = heading | default: 'cart.cross_sell_heading' | t
  assign cross_sell_section_id = 'cart-drawer-cross-sell'

  assign cart_product_ids = cart.items | map: 'product_id'
  assign cart_first_product_id = cart.items.first.product_id
%}

<cart-cross-sell
  class="cart-drawer-cross-sell"
  data-section-id="{{ cross_sell_section_id }}"
  data-source="{{ cross_sell_source }}"
  {% if cross_sell_source == 'recommendations' and cart_first_product_id %}
    data-recommendations-url="{{ routes.product_recommendations_url }}?product_id={{ cart_first_product_id }}&limit={{ cross_sell_max }}&intent={{ cross_sell_recommendation_type }}"
    data-recommendations-intent="{{ cross_sell_recommendation_type }}"
  {% endif %}
  data-max-products="{{ cross_sell_max }}"
  data-cart-product-ids="{{ cart_product_ids | join: ',' }}"
>
  <accordion-custom>
    <details class="details" open>
      <summary class="details__header cart-drawer-cross-sell__header">
        <span class="cart-drawer-cross-sell__title">{{ cross_sell_heading }}</span>
        <span class="svg-wrapper icon-caret icon-animated">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </summary>

      <div class="details__content cart-drawer-cross-sell__content">
        <div class="cart-drawer-cross-sell__carousel-wrapper">
          <button
            type="button"
            class="cart-drawer-cross-sell__arrow cart-drawer-cross-sell__arrow--prev"
            aria-label="{{ 'accessibility.slideshow_previous' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>

          <div class="cart-drawer-cross-sell__carousel" data-carousel>
            {% if cross_sell_source == 'collection' %}
              {% liquid
                assign cross_sell_products = cross_sell_collection.products
              %}
              {%- for product in cross_sell_products limit: cross_sell_max -%}
                {%- unless cart_product_ids contains product.id -%}
                  <div class="cart-drawer-cross-sell__slide">
                    {% render 'cart-cross-sell-card', product: product, section_id: cross_sell_section_id %}
                  </div>
                {%- endunless -%}
              {%- endfor -%}
            {% else %}
              {% comment %} Recommendations mode: show skeleton loaders initially, JS will populate {% endcomment %}
              {%- for i in (1..cross_sell_max) -%}
                <div class="cart-drawer-cross-sell__slide cart-drawer-cross-sell__slide--skeleton" data-skeleton>
                  <div class="cart-cross-sell-card cart-cross-sell-card--skeleton">
                    <div class="skeleton skeleton--image"></div>
                    <div class="skeleton skeleton--text"></div>
                    <div class="skeleton skeleton--text skeleton--short"></div>
                  </div>
                </div>
              {%- endfor -%}
            {% endif %}
          </div>

          <button
            type="button"
            class="cart-drawer-cross-sell__arrow cart-drawer-cross-sell__arrow--next"
            aria-label="{{ 'accessibility.slideshow_next' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      </div>
    </details>
  </accordion-custom>
</cart-cross-sell>

{% stylesheet %}
  .cart-drawer-cross-sell {
    --cross-sell-arrow-size: 28px;
    --cross-sell-icon-size: 12px;
    --cross-sell-slide-width: 70%;
    --cross-sell-padding-inline: 36px;

    display: block;
    padding: 0;
    border: none;
    width: 100%;
  }

  .cart-drawer-cross-sell__header {
    font-size: var(--font-size--sm);
    font-weight: 600;
    padding-block-start: var(--padding-sm);
    padding-block-end: 0;
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-drawer-cross-sell__header::-webkit-details-marker {
    display: none;
  }

  .cart-drawer-cross-sell__title {
    color: var(--color-foreground);
  }

  .cart-drawer-cross-sell__header .icon-caret {
    width: var(--cross-sell-icon-size);
    height: var(--cross-sell-icon-size);
    transition: transform var(--animation-speed-slow) var(--animation-easing);
  }

  .cart-drawer-cross-sell details[open] .icon-caret {
    transform: rotate(180deg);
  }

  .cart-drawer-cross-sell__content {
    padding-block-end: var(--padding-sm);
    overflow: hidden;
  }

  .cart-drawer-cross-sell__carousel-wrapper {
    position: relative;
  }

  .cart-drawer-cross-sell__carousel {
    display: flex;
    gap: var(--gap-sm);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-block: var(--padding-2xs);
    padding-inline: var(--cross-sell-padding-inline);
  }

  .cart-drawer-cross-sell__carousel::-webkit-scrollbar {
    display: none;
  }

  .cart-drawer-cross-sell__slide {
    flex-shrink: 0;
    scroll-snap-align: start;
    width: var(--cross-sell-slide-width);
    min-width: 0;
  }

  .cart-drawer-cross-sell__arrow {
    position: absolute;
    inset-block-start: 50%;
    transform: translateY(-50%);
    width: var(--cross-sell-arrow-size);
    height: var(--cross-sell-arrow-size);
    border-radius: var(--style-border-radius-50);
    background-color: var(--color-background);
    border: var(--style-border-width) solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--animation-speed-slow) var(--animation-easing);
    z-index: var(--layer-flat);
    box-shadow: 0 2px 4px rgb(var(--color-shadow-rgb) / var(--opacity-10));

    &:hover {
      background-color: var(--color-foreground);
      color: var(--color-background);
      border-color: var(--color-foreground);
    }

    &:focus-visible {
      outline: var(--focus-outline-width) solid var(--color-foreground);
      outline-offset: var(--focus-outline-offset);
    }
  }

  .cart-drawer-cross-sell__arrow--prev {
    inset-inline-start: 0;
  }

  .cart-drawer-cross-sell__arrow--next {
    inset-inline-end: 0;
  }

  .cart-drawer-cross-sell__arrow .svg-wrapper {
    width: var(--cross-sell-icon-size);
    height: var(--cross-sell-icon-size);
    display: flex;
    align-items: center;
    justify-content: center;

    svg {
      width: 100%;
      height: 100%;
    }
  }

  .cart-drawer-cross-sell__arrow--prev .svg-wrapper {
    transform: rotate(90deg);
  }

  .cart-drawer-cross-sell__arrow--next .svg-wrapper {
    transform: rotate(-90deg);
  }

  .cart-cross-sell-card--skeleton {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .skeleton {
    background: linear-gradient(
      90deg,
      var(--color-foreground) var(--opacity-10) 25%,
      var(--color-foreground) var(--opacity-5) 50%,
      var(--color-foreground) var(--opacity-10) 75%
    );
    background-size: 200% 100%;
    animation: skeleton-loading 1.5s infinite;
    border-radius: var(--style-border-radius-sm);
  }

  .skeleton--image {
    aspect-ratio: 4/5;
    width: 100%;
  }

  .skeleton--text {
    height: 14px;
    width: 100%;
  }

  .skeleton--short {
    width: 60%;
  }

  @keyframes skeleton-loading {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-drawer-cross-sell__carousel {
      scroll-behavior: auto;
    }

    .cart-drawer-cross-sell__header .icon-caret {
      transition: none;
    }

    .cart-drawer-cross-sell__arrow {
      transition: none;
    }

    .skeleton {
      animation: none;
    }
  }
{% endstylesheet %}
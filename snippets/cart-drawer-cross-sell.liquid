{%- doc -%}
  Renders a cross-sell component inside the cart drawer with accordion and horizontal carousel.

  @param {object} [section] - The section object for section_id
  @param {string} [heading] - Heading text for the accordion (translation key)
  @param {object} [collection] - Collection to show products from
  @param {number} [max_products] - Maximum number of products to show
{%- enddoc -%}

<script
  src="{{ 'cart-cross-sell.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign cross_sell_collection = collection | default: collections.all
  assign cross_sell_max = max_products | default: 8
  assign cross_sell_heading = heading | default: 'cart.cross_sell_heading' | t
  assign cross_sell_section_id = section.id | default: 'cart-drawer-cross-sell'
  assign cross_sell_products = cross_sell_collection.products

  assign cart_product_ids = cart.items | map: 'product_id'
%}

{%- if cross_sell_products.size > 0 -%}
  <cart-cross-sell class="cart-drawer-cross-sell" data-section-id="{{ cross_sell_section_id }}">
    <accordion-custom>
      <details class="details">
        <summary class="details__header cart-drawer-cross-sell__header">
          <span class="cart-drawer-cross-sell__title">{{ cross_sell_heading }}</span>
          <span class="svg-wrapper icon-caret icon-animated">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </summary>

        <div class="details__content cart-drawer-cross-sell__content">
          <div class="cart-drawer-cross-sell__carousel-wrapper">
            <button
              type="button"
              class="cart-drawer-cross-sell__arrow cart-drawer-cross-sell__arrow--prev"
              aria-label="{{ 'accessibility.slideshow_previous' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </button>

            <div class="cart-drawer-cross-sell__carousel">
              {%- for product in cross_sell_products limit: cross_sell_max -%}
                {%- unless cart_product_ids contains product.id -%}
                  <div class="cart-drawer-cross-sell__slide">
                    {% render 'cart-cross-sell-card', product: product, section_id: cross_sell_section_id %}
                  </div>
                {%- endunless -%}
              {%- endfor -%}
            </div>

            <button
              type="button"
              class="cart-drawer-cross-sell__arrow cart-drawer-cross-sell__arrow--next"
              aria-label="{{ 'accessibility.slideshow_next' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>
        </div>
      </details>
    </accordion-custom>
  </cart-cross-sell>
{%- endif -%}

{% stylesheet %}
  .cart-drawer-cross-sell {
    --cross-sell-arrow-size: 28px;
    --cross-sell-icon-size: 12px;
    --cross-sell-slide-width: 70%;
    --cross-sell-padding-inline: 36px;

    display: block;
    padding: 0;
    border: none;
    width: 100%;
  }

  .cart-drawer-cross-sell__header {
    font-size: var(--font-size--sm);
    font-weight: 600;
    padding-block-start: var(--padding-sm);
    padding-block-end: 0;
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-drawer-cross-sell__header::-webkit-details-marker {
    display: none;
  }

  .cart-drawer-cross-sell__title {
    color: var(--color-foreground);
  }

  .cart-drawer-cross-sell__header .icon-caret {
    width: var(--cross-sell-icon-size);
    height: var(--cross-sell-icon-size);
    transition: transform var(--animation-speed-slow) var(--animation-easing);
  }

  .cart-drawer-cross-sell details[open] .icon-caret {
    transform: rotate(180deg);
  }

  .cart-drawer-cross-sell__content {
    padding-block-end: var(--padding-sm);
    overflow: hidden;
  }

  .cart-drawer-cross-sell__carousel-wrapper {
    position: relative;
  }

  .cart-drawer-cross-sell__carousel {
    display: flex;
    gap: var(--gap-sm);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-block: var(--padding-2xs);
    padding-inline: var(--cross-sell-padding-inline);
  }

  .cart-drawer-cross-sell__carousel::-webkit-scrollbar {
    display: none;
  }

  .cart-drawer-cross-sell__slide {
    flex-shrink: 0;
    scroll-snap-align: start;
    width: var(--cross-sell-slide-width);
    min-width: 0;
  }

  .cart-drawer-cross-sell__arrow {
    position: absolute;
    inset-block-start: 50%;
    transform: translateY(-50%);
    width: var(--cross-sell-arrow-size);
    height: var(--cross-sell-arrow-size);
    border-radius: var(--style-border-radius-50);
    background-color: var(--color-background);
    border: var(--style-border-width) solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--animation-speed-slow) var(--animation-easing);
    z-index: var(--layer-flat);
    box-shadow: 0 2px 4px rgb(var(--color-shadow-rgb) / var(--opacity-10));

    &:hover {
      background-color: var(--color-foreground);
      color: var(--color-background);
      border-color: var(--color-foreground);
    }

    &:focus-visible {
      outline: var(--focus-outline-width) solid var(--color-foreground);
      outline-offset: var(--focus-outline-offset);
    }
  }

  .cart-drawer-cross-sell__arrow--prev {
    inset-inline-start: 0;
  }

  .cart-drawer-cross-sell__arrow--next {
    inset-inline-end: 0;
  }

  .cart-drawer-cross-sell__arrow .svg-wrapper {
    width: var(--cross-sell-icon-size);
    height: var(--cross-sell-icon-size);
    display: flex;
    align-items: center;
    justify-content: center;

    svg {
      width: 100%;
      height: 100%;
    }
  }

  .cart-drawer-cross-sell__arrow--prev .svg-wrapper {
    transform: rotate(90deg);
  }

  .cart-drawer-cross-sell__arrow--next .svg-wrapper {
    transform: rotate(-90deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-drawer-cross-sell__carousel {
      scroll-behavior: auto;
    }

    .cart-drawer-cross-sell__header .icon-caret {
      transition: none;
    }

    .cart-drawer-cross-sell__arrow {
      transition: none;
    }
  }
{% endstylesheet %}

{%- comment -%}
  Quick Buy Overlay - Exact Reference Design

  POSITION: Inside card-gallery, floating over product image
  STRUCTURE:
    1. TOP ROW: Sizes (uppercase, underlined when selected, gray when out of stock)
    2. BOTTOM ROW: Colors (left) + CTA "Agregar a la bolsa →" (right)

  Uses native Shopify swatch system: option.values -> value.swatch.color / value.swatch.image
  Integrates with plp-variants.js changeImage function for image switching

  @param {object} product - The product object
{%- endcomment -%}

{% liquid
  # Detect color and size options using native Shopify option system
  assign has_color_option = false
  assign has_size_option = false
  assign color_option = null
  assign size_option = null
  assign color_option_index = 0
  assign size_option_index = 1

  for option in product.options_with_values
    assign option_name_downcase = option.name | downcase
    if option_name_downcase == 'color' or option_name_downcase == 'colour' or option_name_downcase == 'color/colour'
      assign has_color_option = true
      assign color_option = option
      assign color_option_index = forloop.index0
    endif
    if option_name_downcase == 'size' or option_name_downcase == 'talla' or option_name_downcase == 'sizes' or option_name_downcase == 'tallas'
      assign has_size_option = true
      assign size_option = option
      assign size_option_index = forloop.index0
    endif
  endfor

  # Build unique sizes array maintaining order
  assign unique_sizes = '' | split: ','
  if has_size_option
    for value in size_option.values
      assign size_name = value | strip
      unless unique_sizes contains size_name
        assign unique_sizes = unique_sizes | push: size_name
      endunless
    endfor
  endif

  # Build unique colors array with swatch data
  assign unique_colors = '' | split: ','
  if has_color_option
    for value in color_option.values
      assign color_name = value | strip
      unless unique_colors contains color_name
        assign unique_colors = unique_colors | push: color_name
      endunless
    endfor
  endif

  # Only show if product is available and has options
  assign show_quick_buy = false
  if product.available and unique_sizes.size > 0
    assign show_quick_buy = true
  endif
%}

{% if show_quick_buy %}
  <div
    class="quick-buy-overlay"
    data-product-id="{{ product.id }}"
    data-color-option-index="{{ color_option_index }}"
    data-size-option-index="{{ size_option_index }}"
  >
    {%- comment -%}
      ═══════════════════════════════════════════════════════════
        ZONA SUPERIOR — TALLAS (alineadas a la izquierda)
        - Fila horizontal de tallas en texto plano
        - MAYÚSCULA con tracking ligero
        - Una talla preseleccionada
        - Sin stock: gris, cursor not-allowed, pointer-events none
      ═══════════════════════════════════════════════════════════
    {%- endcomment -%}

    <div class="quick-buy-overlay__sizes">
      {% for size_name in unique_sizes %}
        {% assign first_available_for_size = false %}
        {% assign size_variant_exists = false %}

        {%- comment -%} Check if any variant with this size is available {%- endcomment -%}
        {% for variant in product.variants %}
          {% assign variant_size = variant.options[size_option_index] | strip %}
          {% if variant_size == size_name %}
            {% assign size_variant_exists = true %}
            {% if variant.available %}
              {% assign first_available_for_size = true %}
              {% break %}
            {% endif %}
          {% endif %}
        {% endfor %}

        {% assign is_disabled = false %}
        {% unless first_available_for_size %}
          {% assign is_disabled = true %}
        {% endunless %}

        <button
          type="button"
          class="quick-buy-overlay__size{% if forloop.first and first_available_for_size %} quick-buy-overlay__size--active{% endif %}{% if is_disabled %} quick-buy-overlay__size--disabled{% endif %}"
          data-size="{{ size_name }}"
          data-product-id="{{ product.id }}"
          {% if is_disabled %}
            disabled aria-disabled="true"
          {% endif %}
          {% if forloop.first and first_available_for_size %}
            data-preselected="true"
          {% endif %}
        >
          {{ size_name | upcase }}
        </button>
      {% endfor %}
    </div>

    {%- comment -%}
      ═══════════════════════════════════════════════════════════
        ZONA INFERIOR — DIVIDIDA EN DOS PARTES
        IZQUIERDA: Colores (cuadrados pequeños 16px, underline negro al seleccionar)
        DERECHA: CTA "Agregar a la bolsa →"
      ═══════════════════════════════════════════════════════════
    {%- endcomment -%}

    <div class="quick-buy-overlay__bottom">
      {%- comment -%} COLORES (IZQUIERDA) {%- endcomment -%}
      {% if has_color_option and unique_colors.size > 0 %}
        <div class="quick-buy-overlay__colors">
          {% for color_name in unique_colors %}
            {%- comment -%} Find the swatch data from options_with_values {%- endcomment -%}
            {% assign swatch_color = null %}
            {% assign swatch_image = null %}

            {% for value in color_option.values %}
              {% if value == color_name %}
                {% if value.swatch.color %}
                  {% assign swatch_color = value.swatch.color %}
                {% endif %}
                {% if value.swatch.image %}
                  {% assign swatch_image = value.swatch.image %}
                {% endif %}
                {% break %}
              {% endif %}
            {% endfor %}

            {%- comment -%} Fallback: try to get color from variant featured image {%- endcomment -%}
            {% assign fallback_image = null %}
            {% if swatch_color == null and swatch_image == null %}
              {% for variant in product.variants %}
                {% assign variant_color = variant.options[color_option_index] | strip %}
                {% if variant_color == color_name and variant.featured_media %}
                  {% assign fallback_image = variant.featured_media.preview_image %}
                  {% break %}
                {% endif %}
              {% endfor %}
            {% endif %}

            <button
              type="button"
              class="quick-buy-overlay__color{% if forloop.first %} quick-buy-overlay__color--active{% endif %}"
              data-color="{{ color_name }}"
              data-product-id="{{ product.id }}"
              title="{{ color_name }}"
              {% if forloop.first %}
                data-preselected="true"
              {% endif %}
            >
              {% if swatch_image %}
                {%- comment -%} Swatch with image pattern {%- endcomment -%}
                <span
                  class="quick-buy-overlay__swatch"
                  style="background-image: url('{{ swatch_image | image_url: width: 64 }}'); background-size: cover; background-position: center;"
                ></span>
              {% elsif swatch_color %}
                {%- comment -%} Swatch with solid color {%- endcomment -%}
                <span
                  class="quick-buy-overlay__swatch"
                  style="background-color: {{ swatch_color }};"
                ></span>
              {% elsif fallback_image %}
                {%- comment -%} Fallback: use variant image as swatch {%- endcomment -%}
                <span
                  class="quick-buy-overlay__swatch"
                  style="background-image: url('{{ fallback_image | image_url: width: 64, height: 64, crop: 'center' }}'); background-size: cover; background-position: center;"
                ></span>
              {% else %}
                {%- comment -%} Ultimate fallback: color name initial {%- endcomment -%}
                <span
                  class="quick-buy-overlay__swatch quick-buy-overlay__swatch--fallback"
                  data-initial="{{ color_name | slice: 0, 1 | upcase }}"
                ></span>
              {% endif %}
            </button>
          {% endfor %}
        </div>
      {% else %}
        {%- comment -%} No colors - empty spacer to push CTA right {%- endcomment -%}
        <div class="quick-buy-overlay__colors-spacer"></div>
      {% endif %}

      {%- comment -%} CTA — "Agregar a la bolsa →" (DERECHA) {%- endcomment -%}
      <button
        type="button"
        class="quick-buy-overlay__cta"
        data-product-id="{{ product.id }}"
        disabled
      >
        Agregar a la bolsa →
      </button>
    </div>
  </div>
{% endif %}

{%- comment -%}
  ═══════════════════════════════════════════════════════════
    CSS STYLES - EXACT REFERENCE DESIGN
  ═══════════════════════════════════════════════════════════
{%- endcomment -%}

{% stylesheet %}
  /* ══════════════════════════════════════════════════════════════
     QUICK BUY OVERLAY - CONTAINER
     Position: absolute within card-gallery, floating over image
  ══════════════════════════════════════════════════════════════ */

  .card-gallery {
    position: relative;
  }

  .quick-buy-overlay {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: 16px;
    background: #ffffff;
    padding: 16px 18px;
    border-radius: 2px;
    box-shadow: 0px 6px 16px rgba(0, 0, 0, 0.12);
    z-index: 10;

    /* Hidden by default, show on hover */
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  /* Show on product card hover */
  .product-card:hover .quick-buy-overlay,
  .card-gallery:hover .quick-buy-overlay {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* ══════════════════════════════════════════════════════════════
     ZONA SUPERIOR — TALLAS
     Font: 14px, 400 weight, 0.03em tracking
     Display: flex, gap 18px, margin-bottom 12px
  ══════════════════════════════════════════════════════════════ */

  .quick-buy-overlay__sizes {
    display: flex;
    gap: 18px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .quick-buy-overlay__size {
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: #000000;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
    line-height: 1.2;
    transition: opacity 0.15s ease;
  }

  .quick-buy-overlay__size:hover:not(.quick-buy-overlay__size--disabled) {
    opacity: 0.7;
  }

  /* Size selected state */
  .quick-buy-overlay__size--active {
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
  }

  /* Size out of stock state */
  .quick-buy-overlay__size--disabled {
    color: #9a9a9a;
    opacity: 0.5;
    pointer-events: none;
    cursor: not-allowed;
  }

  /* ══════════════════════════════════════════════════════════════
     ZONA INFERIOR — COLORS + CTA
     Flex row, justify space-between
  ══════════════════════════════════════════════════════════════ */

  .quick-buy-overlay__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* ══════════════════════════════════════════════════════════════
     COLORES (IZQUIERDA)
     Small squares: 16px, border-radius 2px
     Gap 8px between colors
     Active: black underline
  ══════════════════════════════════════════════════════════════ */

  .quick-buy-overlay__colors {
    display: flex;
    gap: 8px;
  }

  .quick-buy-overlay__colors-spacer {
    flex: 1;
  }

  .quick-buy-overlay__color {
    width: 16px;
    height: 16px;
    border-radius: 2px;
    position: relative;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    transition: transform 0.15s ease;
  }

  .quick-buy-overlay__color:hover {
    transform: scale(1.1);
  }

  /* Color swatch inner element */
  .quick-buy-overlay__swatch {
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 2px;
  }

  /* Fallback swatch with initial letter */
  .quick-buy-overlay__swatch--fallback {
    background: #e5e5e5;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    font-weight: 500;
    color: #666666;
  }

  .quick-buy-overlay__swatch--fallback::before {
    content: attr(data-initial);
  }

  /* Color active state - black underline */
  .quick-buy-overlay__color--active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 1px;
    background: #000000;
  }

  /* ══════════════════════════════════════════════════════════════
     CTA — "Agregar a la bolsa →" (DERECHA)
     Font: 14px, underlined, text-underline-offset 3px
     Disabled: gray, no underline, cursor not-allowed
  ══════════════════════════════════════════════════════════════ */

  .quick-buy-overlay__cta {
    font-size: 14px;
    color: #000000;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    font-weight: 400;
    white-space: nowrap;
    transition: opacity 0.15s ease;
  }

  .quick-buy-overlay__cta:hover:not(:disabled) {
    opacity: 0.7;
  }

  .quick-buy-overlay__cta:disabled {
    color: #9a9a9a;
    text-decoration: none;
    cursor: not-allowed;
    opacity: 0.5;
  }

  /* ══════════════════════════════════════════════════════════════
     RESPONSIVE ADJUSTMENTS
  ══════════════════════════════════════════════════════════════ */

  @media screen and (max-width: 749px) {
    .quick-buy-overlay {
      bottom: 12px;
      left: 12px;
      right: 12px;
      padding: 14px 16px;
    }

    .quick-buy-overlay__sizes {
      gap: 14px;
      margin-bottom: 10px;
    }

    .quick-buy-overlay__size {
      font-size: 13px;
    }

    .quick-buy-overlay__color {
      width: 14px;
      height: 14px;
    }

    .quick-buy-overlay__swatch {
      width: 14px;
      height: 14px;
    }

    .quick-buy-overlay__cta {
      font-size: 13px;
    }
  }

  /* Hide quick buy on very small screens where hover doesn't work well */
  @media screen and (max-width: 480px) {
    .quick-buy-overlay {
      display: none;
    }
  }
{% endstylesheet %}

{%- comment -%}
  ═══════════════════════════════════════════════════════════
    JAVASCRIPT - Full functionality with plp-variants.js integration
  ═══════════════════════════════════════════════════════════
{%- endcomment -%}

{% if show_quick_buy %}
  <script>
    (function () {
      'use strict';

      const productId = '{{ product.id }}';
      const overlayElement = document.querySelector(`.quick-buy-overlay[data-product-id="${productId}"]`);

      if (!overlayElement) return;

      // Get option indices from data attributes
      const colorOptionIndex = parseInt(overlayElement.dataset.colorOptionIndex) || 0;
      const sizeOptionIndex = parseInt(overlayElement.dataset.sizeOptionIndex) || 1;

      // State management
      const state = {
        selectedColor: null,
        selectedSize: null,
        selectedVariantId: null,
      };

      // Product data from window.PLP (populated by product-card.liquid)
      const productData = window.PLP?.[productId];

      if (!productData || !productData.variants) {
        console.warn('Quick Buy: No product data found for', productId);
        return;
      }

      // ═══════════════════════════════════════════════════════════
      // HELPER FUNCTIONS
      // ═══════════════════════════════════════════════════════════

      function findVariant(color, size) {
        return productData.variants.find((variant) => {
          const variantColor = variant.options[colorOptionIndex];
          const variantSize = variant.options[sizeOptionIndex];

          // If no color option, just match size
          if (color === null) {
            return variantSize === size;
          }

          return variantColor === color && variantSize === size;
        });
      }

      function updateSizeAvailability(selectedColor) {
        const sizeButtons = overlayElement.querySelectorAll('.quick-buy-overlay__size');

        sizeButtons.forEach((sizeButton) => {
          const size = sizeButton.dataset.size;
          const variant = findVariant(selectedColor, size);

          if (variant && variant.available) {
            sizeButton.classList.remove('quick-buy-overlay__size--disabled');
            sizeButton.disabled = false;
            sizeButton.removeAttribute('aria-disabled');
          } else {
            sizeButton.classList.add('quick-buy-overlay__size--disabled');
            sizeButton.disabled = true;
            sizeButton.setAttribute('aria-disabled', 'true');
          }
        });
      }

      function updateCTAButton() {
        const ctaButton = overlayElement.querySelector('.quick-buy-overlay__cta');

        if (state.selectedSize && state.selectedVariantId) {
          ctaButton.disabled = false;
        } else {
          ctaButton.disabled = true;
        }
      }

      function updateProductImage(variantId) {
        // Use existing changeImage function from plp-variants.js
        if (typeof window.changeImage === 'function') {
          const variant = productData.variants.find((v) => v.id === parseInt(variantId));
          if (variant) {
            window.changeImage(productId, variant);
          }
        } else {
          // Fallback: try to find and update slideshow directly
          const variant = productData.variants.find((v) => v.id === parseInt(variantId));
          if (!variant) return;

          const productCard = overlayElement.closest('product-card');
          const slideshow = productCard?.querySelector('slideshow-component');

          if (slideshow && variant.featured_media_id) {
            const slide = slideshow.querySelector(`slideshow-slide[slide-id="${variant.featured_media_id}"]`);
            if (slide) {
              // Dispatch custom event to change slide
              slideshow.dispatchEvent(
                new CustomEvent('slide-select', {
                  detail: { id: variant.featured_media_id, animate: false },
                })
              );
            }
          }
        }
      }

      function preselectFirstAvailableSize() {
        const sizeButtons = overlayElement.querySelectorAll(
          '.quick-buy-overlay__size:not(.quick-buy-overlay__size--disabled)'
        );

        if (sizeButtons.length > 0) {
          const firstAvailable = sizeButtons[0];

          // Clear previous selection
          overlayElement.querySelectorAll('.quick-buy-overlay__size').forEach((btn) => {
            btn.classList.remove('quick-buy-overlay__size--active');
          });

          // Select first available
          firstAvailable.classList.add('quick-buy-overlay__size--active');
          state.selectedSize = firstAvailable.dataset.size;

          // Find and set variant
          const variant = findVariant(state.selectedColor, state.selectedSize);
          if (variant) {
            state.selectedVariantId = variant.id;
          }

          updateCTAButton();
        }
      }

      // ═══════════════════════════════════════════════════════════
      // COLOR SELECTION HANDLERS
      // ═══════════════════════════════════════════════════════════

      const colorButtons = overlayElement.querySelectorAll('.quick-buy-overlay__color');

      colorButtons.forEach((colorButton) => {
        colorButton.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();

          const color = this.dataset.color;

          // Update active state
          colorButtons.forEach((btn) => btn.classList.remove('quick-buy-overlay__color--active'));
          this.classList.add('quick-buy-overlay__color--active');

          // Update state
          state.selectedColor = color;

          // Check if current size is still available for new color
          const currentSize = state.selectedSize;
          const previousVariant = currentSize ? findVariant(color, currentSize) : null;

          if (!previousVariant || !previousVariant.available) {
            // Current size not available, reset
            state.selectedSize = null;
            state.selectedVariantId = null;

            // Clear size selection visual
            overlayElement.querySelectorAll('.quick-buy-overlay__size').forEach((btn) => {
              btn.classList.remove('quick-buy-overlay__size--active');
            });
          } else {
            // Size still available, update variant
            state.selectedVariantId = previousVariant.id;
          }

          // Update size availability for new color
          updateSizeAvailability(color);

          // Preselect first available size if none selected
          if (!state.selectedSize) {
            preselectFirstAvailableSize();
          }

          // Update CTA button state
          updateCTAButton();

          // Update product image
          const availableVariant = productData.variants.find(
            (v) => v.options[colorOptionIndex] === color && v.available
          );
          if (availableVariant) {
            updateProductImage(availableVariant.id);
          }
        });
      });

      // ═══════════════════════════════════════════════════════════
      // SIZE SELECTION HANDLERS
      // ═══════════════════════════════════════════════════════════

      const sizeButtons = overlayElement.querySelectorAll('.quick-buy-overlay__size');

      sizeButtons.forEach((sizeButton) => {
        sizeButton.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();

          if (this.classList.contains('quick-buy-overlay__size--disabled')) return;

          const size = this.dataset.size;

          // Update active state
          sizeButtons.forEach((btn) => btn.classList.remove('quick-buy-overlay__size--active'));
          this.classList.add('quick-buy-overlay__size--active');

          // Update state
          state.selectedSize = size;

          // Find and set variant
          const variant = findVariant(state.selectedColor, size);
          if (variant) {
            state.selectedVariantId = variant.id;

            // Update product image
            updateProductImage(variant.id);
          }

          // Update CTA button
          updateCTAButton();
        });
      });

      // ═══════════════════════════════════════════════════════════
      // ADD TO CART HANDLER
      // ═══════════════════════════════════════════════════════════

      const ctaButton = overlayElement.querySelector('.quick-buy-overlay__cta');

      ctaButton.addEventListener('click', async function (e) {
        e.preventDefault();
        e.stopPropagation();

        if (!state.selectedVariantId) return;

        const originalText = this.textContent;
        this.textContent = 'Agregando...';
        this.disabled = true;

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              id: state.selectedVariantId,
              quantity: 1,
            }),
          });

          if (response.ok) {
            const result = await response.json();
            console.log('Quick Buy: Added to cart', result);

            // Success feedback
            this.textContent = '✓ Añadido';

            setTimeout(() => {
              this.textContent = originalText;
              this.disabled = false;
            }, 2000);

            // Fetch real cart state for accurate total item count
            const cartResponse = await fetch('/cart.js');
            const cart = await cartResponse.json();

            // Dispatch cart:update with real total so Horizon cart-icon + cart-drawer update
            document.dispatchEvent(
              new CustomEvent('cart:update', {
                bubbles: true,
                detail: {
                  resource: cart,
                  sourceId: 'quick-buy-overlay',
                  data: {
                    source: 'quick-buy-overlay',
                    itemCount: cart.item_count,
                    variantId: String(state.selectedVariantId),
                    productId: productId,
                  },
                },
              })
            );
          } else {
            console.error('Quick Buy: Error adding to cart', await response.text());
            this.textContent = 'Error';
            setTimeout(() => {
              this.textContent = originalText;
              this.disabled = false;
            }, 2000);
          }
        } catch (error) {
          console.error('Quick Buy: Network error', error);
          this.textContent = 'Error';
          setTimeout(() => {
            this.textContent = originalText;
            this.disabled = false;
          }, 2000);
        }
      });

      // ═══════════════════════════════════════════════════════════
      // INITIALIZATION
      // ═══════════════════════════════════════════════════════════

      // Get preselected color
      const preselectedColor = overlayElement.querySelector('.quick-buy-overlay__color[data-preselected="true"]');
      if (preselectedColor) {
        state.selectedColor = preselectedColor.dataset.color;
      }

      // Update size availability based on preselected color
      if (state.selectedColor) {
        updateSizeAvailability(state.selectedColor);
      }

      // Preselect first available size
      setTimeout(() => {
        preselectFirstAvailableSize();
      }, 50);
    })();
  </script>
{% endif %}

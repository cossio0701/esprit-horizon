<script src="{{ 'carousel-component.js' | asset_url }}" type="module" fetchpriority="low"></script>
{{ 'carousel.css' | asset_url | stylesheet_tag }}

<quick-add-dialog id="quick-add-dialog">
  <dialog
    class="quick-add-modal dialog-modal color-{{ settings.popover_color_scheme }}"
    ref="dialog"
    scroll-lock
  >
    <div ref="dragHandle" class="quick-add-modal__drag-handle">
      <span class="quick-add-modal__drag-handle-bar"></span>
    </div>

    <button
      ref="closeButton"
      on:click="/closeDialog"
      class="button button-unstyled close-button quick-add-modal__close"
      aria-label="{{ 'accessibility.close_dialog' | t }}"
    >
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>

    <div
      id="quick-add-modal-content"
      class="quick-add-modal__content"
    ></div>
  </dialog>
</quick-add-dialog>

{% stylesheet %}
  .quick-add-modal {
    --modal-border-radius-mobile: 16px;
    --modal-max-height-mobile: 90dvh;

    padding: 0;
    overflow: hidden;
    box-shadow: var(--shadow-drawer);

    @media screen and (min-width: 750px) {
      position: fixed;
      width: calc(var(--sidebar-width) - 40px);
      max-width: 95vw;
      height: 100%;
      margin: 0 0 0 auto;
      border: none;
      border-inline-start: var(--style-border-drawer);
      border-radius: 0;
      max-height: 100dvh;
    }

    @media screen and (max-width: 749px) {
      position: fixed;
      display: flex;
      flex-direction: column;
      margin: auto 0 0 0;
      min-height: unset;
      max-width: 100%;
      overflow: hidden;
      padding: 0;
      border: var(--style-border-popover);
      border-radius: var(--modal-border-radius-mobile) var(--modal-border-radius-mobile) 0 0;
      height: auto;
      max-height: var(--modal-max-height-mobile);
      -webkit-overflow-scrolling: touch;
      will-change: transform;
    }
  }

  .quick-add-modal[open] {
    @media screen and (min-width: 750px) {
      display: flex;
      flex-direction: column;
      animation: slideInFromRight var(--animation-speed) var(--animation-easing) forwards;
    }

    @media screen and (max-width: 749px) {
      animation: bottomSheetSlideIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
  }

  .quick-add-modal.dialog-closing {
    @media screen and (min-width: 750px) {
      animation: slideOutToRight var(--animation-speed) var(--animation-easing) forwards;
    }

    @media screen and (max-width: 749px) {
      animation: bottomSheetSlideOut 0.8s cubic-bezier(0.55, 0, 1, 0.45) forwards;
    }
  }

  .quick-add-modal__close {
    position: absolute;
    inset-block-start: var(--margin-2xs);
    inset-inline-end: var(--margin-2xs);
    transition: transform 0.15s var(--animation-timing-bounce);
    z-index: var(--layer-raised);

    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .quick-add-modal__close:active {
    transform: scale(0.8);
  }

  .quick-add-modal__drag-handle {
    display: none;

    @media screen and (max-width: 749px) {
      display: flex;
      justify-content: center;
      align-items: center;
      padding-block: 14px 10px;
      cursor: pointer;
      touch-action: none;
    }
  }

  .quick-add-modal__drag-handle-bar {
    inline-size: 36px;
    block-size: 4px;
    border-radius: 2px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-30));
    transition: transform 0.15s ease;
  }

  .quick-add-modal__drag-handle:active .quick-add-modal__drag-handle-bar {
    transform: scaleX(0.85);
  }

  .quick-add-modal__content {
    display: flex;
    flex-direction: column;
    position: relative;
    overflow-y: auto;
    height: 100%;
    min-height: 0;

    @media screen and (min-width: 750px) {
      width: 100%;
      max-width: 100%;
      max-height: 100%;
    }

    @media screen and (max-width: 749px) {
      width: 100vw;
      max-width: var(--wide-content-width);
      max-height: 100vh;
      padding-inline: var(--padding-lg);
      padding-block: var(--padding-lg) 60px;
      gap: var(--gap-lg);
      flex: 1 1 auto;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      height: 100%;
    }
  }

  .quick-add-modal__content .view-more-details__wrapper {
    display: flex;
    justify-content: center;
    width: 100%;

    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .view-more-details__wrapper .view-more-details {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quick-add-modal__content .product-header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
    margin-block-end: var(--margin-sm);
  }

  .quick-add-modal__content .product-header a:not(product-price *) {
    @media screen and (max-width: 749px) {
      font-size: var(--font-size-md, 14px);
      font-weight: 500;
      color: inherit;
      width: fit-content;
    }
  }

  .quick-add-modal__content variant-picker,
  .quick-add-modal__content product-form-component {
    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .quick-add-modal__content .variant-picker__form {
    display: block;
  }

  .quick-add-modal__content .variant-option + .variant-option {
    margin-block-start: var(--padding-lg);
  }

  .quick-add-modal__content .product-media-container__zoom-button {
    cursor: default;
  }

  .quick-add-modal__info {
    padding: var(--padding-lg);
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .quick-add-modal__content .product-details {
    display: none;
  }

  .quick-add-modal__content > * {
    min-height: 0;
  }

  .quick-add-modal__content .product-details :is(.view-product-title, .buy-buttons-block) {
    flex: 0 0 auto;
  }

  .quick-add-modal__content .product-details .variant-picker {
    --product-swatches-padding-block-end: 0px;

    flex: 1 1 auto;
    overflow-y: auto;
    min-height: 0;
    padding-block-end: calc(
      var(--product-swatches-padding-block-end) + var(--focus-outline-offset) + var(--focus-outline-width)
    );
  }

  .quick-add-modal__content .variant-option--swatches {
    padding-inline-start: var(--padding-2xs);
  }

  .quick-add-modal__content .variant-option--swatches legend {
    margin-inline-start: calc(-1 * var(--padding-2xs));
    font-weight: 600;
  }

  .quick-add-modal__content:not(:has(.product-information__media, .section-variant-gallery, .gallery-main-container))
    .product-details {
    grid-column: 1 / -1;
  }

  .quick-add-modal__content .product-title-row__link {
    font-size: var(--font-size-xl, 18px);

    @media screen and (max-width: 749px) {
      font-size: 14px;
    }
  }

  .quick-add-modal__content .view-product-title {
    display: flex;
    padding-block: 0;
    padding-inline: 0 calc(var(--minimum-touch-target) / 2);
  }

  .quick-add-modal__content .view-product-title a {
    color: inherit;
    text-decoration: none;
    text-align: start;
    font-size: var(--font-size-xl, 18px);
    font-weight: 600;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.2s var(--animation-easing);

    @media screen and (max-width: 749px) {
      font-size: 14px;
    }
  }

  .quick-add-modal__content
    .product-details
    *:not(
      .group-block,
      .group-block-content,
      .buy-buttons-block,
      .buy-buttons-block *,
      .view-product-title,
      .view-product-title *,
      variant-picker,
      variant-picker *,
      product-price,
      product-price *,
      product-inventory,
      product-inventory *,
      .view-more-details__wrapper,
      .view-more-details__wrapper *
    ) {
    @media screen and (min-width: 750px) {
      display: none;
    }
  }

  .quick-add-modal__content
    .group-block:not(
      :has(
          .buy-buttons-block,
          .buy-buttons-block *,
          .view-product-title,
          .view-product-title *,
          variant-picker,
          variant-picker *,
          product-price,
          product-price *,
          product-inventory,
          product-inventory *,
          .view-more-details__wrapper,
          .view-more-details__wrapper *
        ),
      .buy-buttons-block
    ) {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .quick-add-modal__content .group-block-content {
      gap: min(var(--gap-2xl), var(--gap));
    }

    .quick-add-modal__content .media-gallery__grid {
      gap: min(var(--gap-2xs), var(--image-gap));
      border-radius: var(--style-border-radius-popover, 0);
    }

    .quick-add-modal__content .media-gallery--grid .product-media img {
      border-radius: 0;
    }

    .quick-add-modal__content .media-gallery--grid .product-media-container:first-child {
      border-start-end-radius: var(--style-border-radius-popover, 0);
    }

    .quick-add-modal__content .media-gallery--grid .product-media-container:last-child {
      border-end-end-radius: var(--style-border-radius-popover, 0);
    }
  }

  .quick-add-modal__content .product-details > .group-block {
    padding: var(--padding-2xl);
    max-height: 100%;
  }

  .quick-add-modal__content slideshow-controls {
    display: none;
  }

  .quick-add-modal__content slideshow-slide:not([aria-hidden='false']) {
    content-visibility: auto;
  }

  .quick-add-modal__content .sticky-content,
  .quick-add-modal__content .sticky-content--desktop {
    inset-block-start: 0;
  }

  .quick-add-modal__content .text-block.rte:not(product-price),
  .quick-add-modal__content .view-more-details__wrapper {
    display: none;
  }

  @keyframes bottomSheetSlideIn {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  @keyframes bottomSheetSlideOut {
    to {
      transform: translateY(100%);
      opacity: 0;
    }
  }

  @keyframes slideInFromRight {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(0);
    }
  }

  @keyframes slideOutToRight {
    to {
      transform: translateX(100%);
      opacity: 0;
    }
  }
{% endstylesheet %}

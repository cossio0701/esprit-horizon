{%- doc -%}
  Renders a simplified product card for the cart drawer cross-sell carousel.

  @param {object} product - The product object
  @param {string} section_id - The section ID
{%- enddoc -%}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_image = product.featured_image
%}

<div class="cart-cross-sell-card" data-product-id="{{ product.id }}" data-product-url="{{ product.url }}">
  <div class="cart-cross-sell-card__media">
    {%- if featured_image != blank -%}
      {{
        featured_image
        | image_url: width: 200
        | image_tag: loading: 'lazy', class: 'cart-cross-sell-card__image', widths: '100, 150, 200', sizes: '80px'
      }}
    {%- else -%}
      <div class="cart-cross-sell-card__placeholder">
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>

  <div class="cart-cross-sell-card__info">
    <h4 class="cart-cross-sell-card__title">
      {{ product.title }}
    </h4>

    <div class="cart-cross-sell-card__price">
      {%- if product.compare_at_price > product.price -%}
        <span class="cart-cross-sell-card__price-sale">
          {{ product.price | money_with_currency }}
        </span>
        <span class="cart-cross-sell-card__price-compare">
          {{ product.compare_at_price | money_with_currency }}
        </span>
      {%- else -%}
        <span class="cart-cross-sell-card__price-regular">
          {{ product.price | money_with_currency }}
        </span>
      {%- endif -%}
    </div>

    <button
      type="button"
      class="cart-cross-sell-card__quick-buy"
      data-product-url="{{ product.url }}"
      data-product-title="{{ product.title | escape }}"
      aria-label="{{ 'actions.quick_buy' | t: product: product.title | escape }}"
    >
      {{ 'actions.quick_buy' | t }}
    </button>
  </div>
</div>

{% stylesheet %}
  .cart-cross-sell-card {
    --card-media-width: 80px;
    --card-media-height: 100px;
    --card-gap: var(--gap-sm);

    display: flex;
    flex-direction: row;
    flex-shrink: 0;
    scroll-snap-align: start;
    width: 100%;
    gap: var(--card-gap);
  }

  .cart-cross-sell-card__media {
    position: relative;
    width: var(--card-media-width);
    height: var(--card-media-height);
    flex-shrink: 0;
    overflow: hidden;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5-15));
    border-radius: var(--style-border-radius-buttons-primary);
  }

  .cart-cross-sell-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cart-cross-sell-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;

    .placeholder-svg {
      width: 60%;
      height: auto;
      opacity: var(--opacity-20);
    }
  }

  .cart-cross-sell-card__info {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
    flex: 1;
    min-width: 0;
    justify-content: space-evenly;
  }

  .cart-cross-sell-card__title {
    font-family: var(--font-body--family);
    font-size: var(--font-size--2xs);
    font-weight: 400;
    line-height: 1.3;
    color: var(--color-foreground);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cart-cross-sell-card__price {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    font-family: var(--font-body--family);
    font-size: var(--font-size--2xs);
    flex-wrap: wrap;
  }

  .cart-cross-sell-card__price-regular,
  .cart-cross-sell-card__price-sale {
    color: var(--color-foreground);
    font-weight: 600;
  }

  .cart-cross-sell-card__price-compare {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-50));
    text-decoration: line-through;
    font-size: var(--font-size--2xs);
  }

  .cart-cross-sell-card__quick-buy {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-body--family);
    font-size: var(--font-size--2xs);
    font-weight: 500;
    color: var(--color-foreground);
    text-decoration: underline;
    cursor: pointer;
    text-align: start;
    transition: opacity var(--animation-speed-slow) var(--animation-easing);

    &:hover {
      opacity: var(--opacity-70);
    }

    &:active {
      opacity: var(--opacity-50);
    }

    &:focus-visible {
      outline: var(--focus-outline-width) solid var(--color-foreground);
      outline-offset: var(--focus-outline-offset);
      border-radius: var(--style-border-radius-xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-cross-sell-card__quick-buy {
      transition: none;
    }
  }
{% endstylesheet %}

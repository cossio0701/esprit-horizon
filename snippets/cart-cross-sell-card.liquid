{%- doc -%}
  Renders a simplified product card for the cart drawer cross-sell carousel.

  @param {object} product - The product object
  @param {string} section_id - The section ID
{%- enddoc -%}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_image = product.featured_image
%}

<div class="cart-cross-sell-card" data-product-id="{{ product.id }}" data-product-url="{{ product.url }}">
  <div class="cart-cross-sell-card__media">
    {%- if featured_image != blank -%}
      {{
        featured_image
        | image_url: width: 200
        | image_tag: loading: 'lazy', class: 'cart-cross-sell-card__image', widths: '100, 150, 200', sizes: '80px'
      }}
    {%- else -%}
      <div class="cart-cross-sell-card__placeholder">
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>

  <div class="cart-cross-sell-card__info">
    <h4 class="cart-cross-sell-card__title">
      {{ product.title }}
    </h4>

    <div class="cart-cross-sell-card__price">
      {%- if product.compare_at_price > product.price -%}
        <span class="cart-cross-sell-card__price-sale">
          {{ product.price | money }}
        </span>
        <span class="cart-cross-sell-card__price-compare">
          {{ product.compare_at_price | money }}
        </span>
      {%- else -%}
        <span class="cart-cross-sell-card__price-regular">
          {{ product.price | money }}
        </span>
      {%- endif -%}
    </div>

    <button
      type="button"
      class="cart-cross-sell-card__quick-buy"
      data-product-url="{{ product.url }}"
      data-product-title="{{ product.title | escape }}"
      aria-label="{{ 'actions.quick_buy' | t: product: product.title | escape }}"
    >
      {{ 'actions.quick_buy' | t }}
    </button>
  </div>
</div>

{% stylesheet %}
  .cart-cross-sell-card {
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
    scroll-snap-align: start;
    width: 100%;
    gap: 12px;
  }

  .cart-cross-sell-card__media {
    position: relative;
    width: 80px;
    height: 100px;
    flex-shrink: 0;
    overflow: hidden;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5-15));
    border-radius: var(--style-border-radius-buttons-primary, 4px);
  }

  .cart-cross-sell-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cart-cross-sell-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-cross-sell-card__placeholder .placeholder-svg {
    width: 60%;
    height: auto;
    opacity: 0.2;
  }

  .cart-cross-sell-card__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    min-width: 0;
    justify-content: space-evenly;
  }

  .cart-cross-sell-card__title {
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.3;
    color: var(--color-foreground);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cart-cross-sell-card__price {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    flex-wrap: wrap;
  }

  .cart-cross-sell-card__price-regular {
    color: var(--color-foreground);
    font-weight: 600;
  }

  .cart-cross-sell-card__price-sale {
    color: var(--color-foreground);
    font-weight: 600;
  }

  .cart-cross-sell-card__price-compare {
    color: rgb(var(--color-foreground-rgb) / 0.5);
    text-decoration: line-through;
    font-size: 0.65rem;
  }

  .cart-cross-sell-card__quick-buy {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-body--family);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-foreground);
    text-decoration: underline;
    cursor: pointer;
    text-align: left;
    transition: opacity 0.2s ease;
  }

  .cart-cross-sell-card__quick-buy:hover {
    opacity: 0.7;
  }

  .cart-cross-sell-card__quick-buy:active {
    opacity: 0.5;
  }
{% endstylesheet %}

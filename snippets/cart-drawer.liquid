{%- doc -%}
  Renders the cart drawer, a slide-out panel that displays the contents of the cart. It includes the cart icon that acts as a trigger.

  @param {object} [settings] - An object containing theme settings.

  @param {boolean} [settings.auto_open_cart_drawer] - If `true`, the cart drawer opens automatically after an item is
  added.
  @param {string} [settings.drawer_color_scheme] - The color scheme for the drawer.
{%- enddoc -%}

<script
  src="{{ 'cart-drawer.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign auto_open_cart_drawer = section.settings.auto_open_cart_drawer | default: settings.auto_open_cart_drawer, allow_false: true
%}

<cart-drawer-component
  class="cart-drawer"
  {{ block.shopify_attributes }}
  {% if auto_open_cart_drawer %}
    auto-open
  {% endif %}
>
  <button
    class="button header-actions__action button-unstyled"
    on:click="/open"
    aria-haspopup="dialog"
    aria-label="{{ 'accessibility.cart' | t }}"
    aria-describedby="cart-bubble-text"
    data-testid="cart-drawer-trigger"
  >
    {% render 'cart-icon-component' %}
  </button>

  <dialog
    ref="dialog"
    class="cart-drawer__dialog dialog-modal dialog-drawer color-{{ settings.drawer_color_scheme }}{% if cart.empty? %} cart-drawer--empty{%endif%}"
    aria-labelledby="{% if cart.empty? %}cart-drawer-heading-empty{% else %}cart-drawer-heading{% endif %}"
    scroll-lock
  >
    <div class="cart-drawer__inner">
      <cart-items-component
        class="cart-items-component"
        data-section-id="{{ section.id }}"
      >
        <div
          class="cart-drawer__header"
          id="cart-drawer-header"
        >
          <div class="cart-drawer__tabs" ref="tabs">
            <button
              type="button"
              class="cart-drawer__tab active"
              data-tab="cart"
              ref="tabCart"
            >
              Mi bolsa ({{ cart.item_count }})
            </button>
            <button
              type="button"
              class="cart-drawer__tab"
              data-tab="wishlist"
              ref="tabWishlist"
            >
              Mis favoritos (0)
            </button>
          </div>

          <button
            ref="closeButton"
            on:click="cart-drawer-component/close"
            class="button close-button cart-drawer__close-button button-unstyled"
            aria-label="{{ 'actions.close_dialog' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>

        <div
          class="cart-drawer__content motion-reduce active"
          data-tab-content="cart"
          ref="contentCart"
          aria-label="{{ 'accessibility.cart' | t }}"
          style="--header-height: 60px;"
        >
          {%- if cart.empty? -%}
            <div class="cart-drawer__empty-state">
              <h2
                class="cart-drawer__heading h3 cart-drawer__heading--empty"
                id="cart-drawer-heading-empty"
              >
                {{ 'content.your_cart_is_empty' | t }}
              </h2>
              <div class="cart-drawer__items">
                {% render 'cart-products' %}
              </div>
            </div>
          {%- else -%}
            <scroll-hint class="cart-drawer__items">
              {% render 'cart-products' %}
            </scroll-hint>

            <div class="cart-drawer__summary">
              {% render 'cart-summary', simple: true %}
            </div>
          {%- endif -%}
        </div>

        <div
          class="cart-drawer__content motion-reduce"
          data-tab-content="wishlist"
          ref="contentWishlist"
          style="display: none; --header-height: 60px;"
        >
          <div class="cart-drawer__wishlist-empty">
            {% comment %} El espacio quedará en blanco por ahora {% endcomment %}
          </div>
        </div>
      </cart-items-component>
    </div>
  </dialog>
</cart-drawer-component>

{% stylesheet %}
  .cart-items-component {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__heading .cart-bubble {
    width: fit-content;
    border-radius: var(--style-border-radius-buttons-primary);
    aspect-ratio: auto;
    padding: var(--cart-padding);
  }

  .cart-drawer__heading .cart-bubble[data-maintain-ratio] {
    aspect-ratio: 1;
    min-width: 26px;
  }

  .cart-drawer__header {
    background-color: var(--color-background);
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--cart-drawer-padding);
    padding-bottom: 0;
    border-bottom: var(--style-border-width) solid none;
    position: sticky;
    top: 0;
    z-index: 1;
    margin-bottom: 1rem;
    border-bottom: 1px solid #e6e6e6ff;
  }

  .cart-drawer__dialog {
    overflow: hidden;
  }

  .cart-drawer__inner {
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__content {
    height: calc(100% - var(--header-height));
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__summary {
    background-color: var(--color-background);
    position: sticky;
    bottom: 0;
    z-index: 1;
  }

  .cart-drawer__tabs {
    display: flex;
    gap: 20px;
    height: 100%;
    align-items: center;
  }

  .cart-drawer__tab {
    background: transparent;
    border: none;
    padding: 0;
    padding-bottom: 1rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text);
    opacity: 0.5;
    cursor: pointer;
    position: relative;
    height: 40px;
    display: flex;
    align-items: center;
    transition: opacity 0.3s ease;
    text-transform: none;
    letter-spacing: normal;
  }

  .cart-drawer__tab.active {
    opacity: 1;
    font-weight: 700;
    border-bottom: 1px solid;
  }

  .cart-drawer__tab.active::after {
    content: '';
    position: absolute;
    bottom: 0px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-text);
  }

  .cart-drawer__content {
    display: none;
  }

  .cart-drawer__content.active {
    display: flex;
  }

  .cart-drawer__empty-state {
    padding: 20px;
    text-align: center;
  }

  .close-button {
    padding-bottom: 1rem;
  }
{% endstylesheet %}

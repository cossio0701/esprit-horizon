{%- comment -%}
  Intended for blocks and sections that provide values for all the referenced settings.

  <div class="spacing-style" style="{%  render 'spacing-style', settings: section.settings %}">

   Accepts:
      settings: {settings || section.settings}
{%- endcomment -%}

{% assign preset = preset | default: settings.type_preset %}

{%- capture variables -%}
  {%- if preset != 'rte' and settings.color != "" -%}
    --color: {{ settings.color }};
  {%- endif -%}
  {%- if preset == 'custom' -%}
    {% liquid
      unless type
        comment
          When choosing to customize the font, picking a specific font size
          determines the type of text block.
        endcomment
        if settings.font_size != ''
          assign font_size_value = settings.font_size | split: 'rem' | first | times: 1.0

          if font_size_value > 4.5
            assign type = 'display'
          elsif font_size_value > 3.5
            assign type = 'heading'
          else
            assign type = 'body'
          endif
        endif
      endunless
    %}
    {% liquid
      assign font_size_unit = settings.font_size_unit | default: 'px'
      
      if settings.font_size != blank
        assign has_unit = false
        if settings.font_size contains 'rem' or settings.font_size contains 'px' or settings.font_size contains 'em' or settings.font_size contains 'vh' or settings.font_size contains 'vw' or settings.font_size contains '%' or settings.font_size contains 'responsive'
          assign has_unit = true
        endif
        
        if has_unit
           assign font_size_value = settings.font_size
        else
           assign font_size_value = settings.font_size | append: font_size_unit
        endif
      endif

      if settings.font_size_mobile != blank
        assign has_unit_mobile = false
        if settings.font_size_mobile contains 'rem' or settings.font_size_mobile contains 'px' or settings.font_size_mobile contains 'em' or settings.font_size_mobile contains 'vh' or settings.font_size_mobile contains 'vw' or settings.font_size_mobile contains '%'
           assign has_unit_mobile = true
        endif
        
        if has_unit_mobile
           assign font_size_mobile_value = settings.font_size_mobile
        else
           assign font_size_mobile_value = settings.font_size_mobile | append: font_size_unit
        endif
      endif
    %}

    {%- if settings.font_size != blank -%}
      {%- liquid
        assign is_responsive = false
        if font_size_value contains 'responsive' or settings.font_size_unit == 'responsive'
          assign is_responsive = true
        endif

        if is_responsive
          assign desktop_size = settings.font_size | times: 1.0
          assign mobile_size = settings.font_size_mobile | default: settings.font_size | times: 1.0
          
          # Base Desktop = 1280
          assign vw_value = desktop_size | divided_by: 1280.0 | times: 100.0
          
          if desktop_size > mobile_size
             assign min_size = mobile_size
             assign max_size = 1000
          elsif desktop_size < mobile_size
             assign min_size = 0
             assign max_size = mobile_size
          else
             # If equal, scale from mobile size upwards
             assign min_size = mobile_size
             assign max_size = 1000
          endif
        else
          assign font_size_rem = font_size_value | split: 'rem' | first | times: 1.0
          assign is_rem = false
          if font_size_value contains 'rem'
            assign is_rem = true
          endif
          assign fluid_size_cutoff_rem = 3.0

          if is_rem and font_size_rem >= fluid_size_cutoff_rem
            assign target_viewport = 1400
            assign vw_value = font_size_rem | times: 16 | divided_by: target_viewport | times: 100

            assign scale_factor = font_size_rem | divided_by: fluid_size_cutoff_rem
            assign base_min_rem = 3.0
            assign scaling_bonus_rem = scale_factor | minus: 1 | times: 0.25
            assign dynamic_min_rem = base_min_rem | plus: scaling_bonus_rem
          endif
        endif
      -%}
      {%- if is_responsive -%}
        --font-size: clamp({{ min_size }}px, {{ vw_value }}vw, {{ max_size }}px);
      {%- elsif is_rem and font_size_rem >= fluid_size_cutoff_rem -%}
        --font-size: clamp({{ dynamic_min_rem }}rem, {{ vw_value }}vw, {{ font_size_value }});
      {%- else -%}
        --font-size: {{ font_size_value }};
      {%- endif -%}
    {%- endif -%}
    {%- if settings.font_size_mobile != blank -%}
      --font-size-mobile: {{ font_size_mobile_value }};
    {%- endif -%}
    {%- if settings.weight != blank -%}
      --font-weight: {{ settings.weight }};
    {% else %}
      --font-weight: {{ settings.font | replace: 'family', 'weight' }};
    {%- endif -%}
    --font-family: {{ settings.font }};
    --text-transform: {{ settings.case }};
    --text-wrap: {{ settings.wrap }};
    {% if settings.type_preset == 'custom' and settings.font_size == blank %}
      --line-height--display: var(--line-height--display-{{ settings.line_height }});
      --line-height--heading: var(--line-height--heading-{{ settings.line_height }});
      --line-height--body: var(--line-height--body-{{ settings.line_height }});
    {% else %}
      --line-height: var(--line-height--{{ type }}-{{ settings.line_height }});
    {% endif %}
    --letter-spacing: var(--letter-spacing--{{ type }}-{{ settings.letter_spacing }});
  {%- endif -%}
{%- endcapture -%}
{{- variables | strip | strip_newlines -}}

{%- doc -%}
  Renders variant options, properties, and selling plan for a cart line item.

  @param {object} item - The cart line item
  @param {boolean} [prioritize_options] - If true, renders size/color options first (drawer behavior)
{%- enddoc -%}

{%- if item.product.has_only_default_variant == false
  or item.properties.size != 0
  or item.selling_plan_allocation != null
-%}
  <dl class="cart-items__variants">
    {%- if item.product.has_only_default_variant == false and item.item_components.size == 0 -%}
      {%- if prioritize_options -%}
        {%- liquid
          assign size_option = null
          assign color_option = null
          for option in item.options_with_values
            assign name_downcase = option.name | downcase
            if name_downcase contains 'talla' or name_downcase contains 'size'
              assign size_option = option
            elsif name_downcase contains 'color'
              assign color_option = option
            endif
          endfor
        -%}

        {%- if size_option -%}
          <div class="cart-items__variant">
            <dt>{{ 'products.product.size' | t }}:</dt>
            <dd>{{ size_option.value }}</dd>
          </div>
        {%- endif -%}

        {%- if color_option -%}
          <div class="cart-items__variant">
            <dt>{{ 'products.product.color' | t }}:</dt>
            <dd>{{ color_option.value }}</dd>
          </div>
        {%- endif -%}

        {%- for option in item.options_with_values -%}
          {%- assign name_downcase = option.name | downcase -%}
          {%- unless name_downcase contains 'talla'
            or name_downcase contains 'size'
            or name_downcase contains 'color'
          -%}
            <div class="cart-items__variant">
              <dt>{{ option.name }}:</dt>
              <dd>{{ option.value }}</dd>
            </div>
          {%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        {%- for option in item.options_with_values -%}
          <div class="cart-items__variant">
            <dt>{{ option.name }}:</dt>
            <dd>
              {{- option.value -}}
              {%- if forloop.last != true %},&nbsp;{% endif -%}
            </dd>
          </div>
        {%- endfor -%}
      {%- endif -%}
    {%- endif -%}

    {%- for property in item.properties -%}
      {%- assign property_first_char = property.first | slice: 0 -%}
      {%- if property.last != blank and property_first_char != '_' -%}
        <div class="cart-items__properties">
          <dt>{{ property.first }}:</dt>
          <dd>
            {%- if property.last contains '/uploads/' -%}
              <a href="{{ property.last }}">{{ property.last | split: '/' | last }}</a>
            {%- else -%}
              {{ property.last }}
            {%- endif -%}
          </dd>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </dl>

  {% if item.selling_plan_allocation %}
    <p>{{ item.selling_plan_allocation.selling_plan.name }}</p>
  {% endif %}
{%- endif -%}

{%- doc -%}
  Renders the CSS variables for the `gap` styles needed for responsive scaling.
  Intended for use with the `gap-style` class.

  @param {number} value - The base or desktop gap value to use, in pixels.
  @param {string} [name] - The name of the CSS variable to set. Default: 'gap'
  @param {string} [unit] - The unit to use ('px' or 'responsive'). Default: 'px'
  @param {number} [mobile_value] - The mobile gap value to use when unit is 'responsive'.
  @param {number} [scale_min] - Value above which gap scaling will be applied. Default: 20
  @param {boolean} [disable_scaling] - If true, disables scaling and outputs the original value.

  @example
  <div class="gap-style" style="{% render 'gap-style', value: block.settings.gap %}">
{%- enddoc -%}

{%- liquid
  assign scale_min_val = scale_min | default: 24
  assign name = name | default: 'gap'
-%}

{%- if value != blank -%}
  {%- capture gap_css_value -%}
    {%- if unit == 'responsive' -%}
      {%- render 'render-responsive-spacing', unit: 'responsive', desktop_value: value, mobile_value: mobile_value -%}
    {%- else -%}
      {%- if disable_scaling != true and value > scale_min_val -%}
        max({{ scale_min_val }}px, calc(var(--gap-scale, 1.0) * {{ value }}px))
      {%- else -%}
        {{ value }}px
      {%- endif -%}
    {%- endif -%}
  {%- endcapture -%}
  --{{ name }}: {{ gap_css_value | strip_newlines | strip }};
{%- endif -%}

{%- doc -%}
  Renders the shop logo with support for original and inverse variants.

  @param {object} [block_settings] - Settings from the parent block (optional)
  @param {string} [class] - Additional CSS classes
  @param {string} [style] - Inline styles
{%- enddoc -%}

{% liquid
  assign use_inverse_logo = false

  if section.settings.enable_transparent_header_home and template.name == 'index' and section.settings.home_color_scheme == 'inverse'
    assign use_inverse_logo = true
  elsif section.settings.enable_transparent_header_product and template.name == 'product' and section.settings.product_color_scheme == 'inverse'
    assign use_inverse_logo = true
  elsif section.settings.enable_transparent_header_collection and template.name == 'collection' and section.settings.collection_color_scheme == 'inverse'
    assign use_inverse_logo = true
  endif

  if use_inverse_logo
    if settings.logo_inverse != blank
      assign inverse_logo = settings.logo_inverse
    else
      assign inverse_logo = settings.logo
    endif
  endif

  if block_settings.unit == 'responsive'
    assign desktop_height = block_settings.pixel_height | times: 1.0
    assign mobile_height = block_settings.pixel_height_mobile | default: block_settings.pixel_height | times: 1.0

    # Base Viewports: Target 1280px for desktop sizing
    assign desktop_vw = desktop_height | divided_by: 12.8
    assign min_height = mobile_height | append: 'px'
    assign max_height = desktop_height | append: 'px'

    if mobile_height > desktop_height
      assign min_height = desktop_height | append: 'px'
      assign max_height = mobile_height | append: 'px'
    endif

    assign header_logo_height = 'clamp(' | append: min_height | append: ', ' | append: desktop_vw | append: 'vw, ' | append: max_height | append: ')'
    assign header_logo_height_mobile = header_logo_height

    if settings.logo != blank
      assign aspect_ratio = settings.logo.width | times: 1.0 | divided_by: settings.logo.height
      assign desktop_width = desktop_height | times: aspect_ratio
      assign mobile_width = mobile_height | times: aspect_ratio
      assign desktop_width_vw = desktop_width | divided_by: 12.8

      assign min_width = mobile_width | append: 'px'
      assign max_width = desktop_width | append: 'px'

      if mobile_width > desktop_width
        assign min_width = desktop_width | append: 'px'
        assign max_width = mobile_width | append: 'px'
      endif

      assign header_logo_width = 'clamp(' | append: min_width | append: ', ' | append: desktop_width_vw | append: 'vw, ' | append: max_width | append: ')'
      assign header_logo_width_mobile = header_logo_width
    endif

    if inverse_logo != blank
      assign inverse_aspect_ratio = inverse_logo.width | times: 1.0 | divided_by: inverse_logo.height
      assign inverse_desktop_width = desktop_height | times: inverse_aspect_ratio
      assign inverse_mobile_width = mobile_height | times: inverse_aspect_ratio
      assign inverse_desktop_width_vw = inverse_desktop_width | divided_by: 12.8

      assign inverse_min_width = inverse_mobile_width | append: 'px'
      assign inverse_max_width = inverse_desktop_width | append: 'px'

      if inverse_mobile_width > inverse_desktop_width
        assign inverse_min_width = inverse_desktop_width | append: 'px'
        assign inverse_max_width = inverse_mobile_width | append: 'px'
      endif

      assign inverse_header_logo_width = 'clamp(' | append: inverse_min_width | append: ', ' | append: inverse_desktop_width_vw | append: 'vw, ' | append: inverse_max_width | append: ')'
      assign inverse_header_logo_width_mobile = inverse_header_logo_width
    endif
  else
    assign logo_width = settings.logo_height | times: settings.logo.aspect_ratio | ceil
    assign logo_width_mobile = settings.logo_height_mobile | times: settings.logo.aspect_ratio | ceil
    assign inverse_logo_width = settings.logo_height | times: inverse_logo.aspect_ratio | ceil
    assign inverse_logo_width_mobile = settings.logo_height_mobile | times: inverse_logo.aspect_ratio | ceil

    assign header_logo_height = settings.logo_height | append: 'px'
    assign header_logo_height_mobile = settings.logo_height_mobile | append: 'px'
    assign header_logo_width = logo_width | append: 'px'
    assign header_logo_width_mobile = logo_width_mobile | append: 'px'
    assign inverse_header_logo_width = inverse_logo_width | append: 'px'
    assign inverse_header_logo_width_mobile = inverse_logo_width_mobile | append: 'px'
  endif

  assign logo_style = '--header-logo-image-width: ' | append: header_logo_width | append: ';' | append: '--header-logo-image-width-mobile: ' | append: header_logo_width_mobile | append: '; --header-logo-image-height: ' | append: header_logo_height | append: '; --header-logo-image-height-mobile: ' | append: header_logo_height_mobile | append: ';'
  assign inverse_logo_style = '--header-logo-image-width: ' | append: inverse_header_logo_width | append: ';' | append: '--header-logo-image-width-mobile: ' | append: inverse_header_logo_width_mobile | append: '; --header-logo-image-height: ' | append: header_logo_height | append: '; --header-logo-image-height-mobile: ' | append: header_logo_height_mobile | append: ';'
%}

<a
  {% if template.name == 'index' and block_settings.hide_logo_on_home_page %}
    data-hidden-on-home-page
  {% endif %}
  href="{{ routes.root_url }}"
  class="header-logo {{ class }}"
  style="
    {% if block_settings %}
      {% render 'size-style', settings: block_settings %}
      {% render 'spacing-style', settings: block_settings %}
    {% endif %}
    --font-family: var(--font-body--family);
    --font-style: var(--font-body--style);
    --font-weight: 600;
    {{ style }}
  "
>
  <span
    class="header-logo__image-container header-logo__image-container--original"
    data-testid="header-logo"
  >
    {% render 'image',
      image: settings.logo,
      class: 'header-logo__image',
      height: settings.logo_height,
      text_fallback: shop.name,
      style: logo_style
    %}
  </span>

  {% if use_inverse_logo %}
    <span
      class="header-logo__image-container header-logo__image-container--inverse"
      data-testid="header-logo-inverse"
    >
      {% render 'image',
        image: inverse_logo,
        class: 'header-logo__image',
        height: settings.logo_height,
        text_fallback: shop.name,
        style: inverse_logo_style
      %}
    </span>
  {% endif %}
</a>

<style>
  .header-logo {
    display: flex;
    height: 100%;
    font-size: var(--font-size--md);
    font-family: var(--font-body--family);
    font-weight: 600;
    font-style: var(--font-body--style);
    color: var(--color-foreground);
    justify-content: center;
    align-items: center;
    text-decoration: none;

    /* Make sure the logo visually hugs the left edge of the column when it is the first item in the left column */
    margin-inline: calc(-1 * var(--padding-inline-start));

    &[data-hidden-on-home-page] {
      display: none;

      #header-component:is(
          [sticky='always']:not([data-scroll-direction='none']),
          [sticky='scroll-up'][data-scroll-direction='up']
        )
        & {
        display: flex;
      }
    }

    @media screen and (max-width: 749px) {
      padding: 0;
    }

    @media screen and (min-width: 750px) {
      flex-shrink: 0;
    }

    &:hover {
      text-decoration: none;
    }
  }

  .header-logo__image {
    object-fit: contain;
    height: var(--header-logo-image-height-mobile);
    width: var(--header-logo-image-width-mobile);

    @media screen and (min-width: 750px) {
      height: var(--header-logo-image-height);
      width: var(--header-logo-image-width);
    }
  }

  .header-logo:has(.header-logo__image-container--inverse) .header-logo__image-container--original {
    display: var(--header-logo-display, block);
  }

  .header-logo__image-container--inverse {
    display: var(--header-logo-inverse-display, none);
  }
</style>

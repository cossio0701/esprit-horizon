{% comment %}
  Simple Product Card for custom sections
  Renders a product card with image, title, and price

  @param {object} product - The product object
  @param {string} section_id - The section ID
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_image = product.featured_image
%}

<product-card class="product-card product-card-simple" data-product-id="{{ product.id }}">
  <a href="{{ product.url }}" class="product-card-simple__link" ref="productCardLink">
    {% comment %} Product Image {% endcomment %}
    <div class="product-card-simple__media">
      {%- if featured_image != blank -%}
        {{
          featured_image
          | image_url: width: 600
          | image_tag:
            loading: 'lazy',
            class: 'product-card-simple__image',
            widths: '200, 300, 400, 500, 600',
            sizes: '(max-width: 749px) 50vw, 25vw'
        }}
      {%- else -%}
        <div class="product-card-simple__placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}

      {% comment %} Badges {% endcomment %}
      {%- if product.compare_at_price > product.price -%}
        <div class="product-card-simple__badge">
          {%- assign discount = product.compare_at_price
            | minus: product.price
            | times: 100
            | divided_by: product.compare_at_price
          -%}
          -{{ discount }}%
        </div>
      {%- endif -%}

      {% comment %} Quick Add on hover {% endcomment %}
      {%- render 'quick-add-custom', product: product, section_id: section_id -%}
    </div>

    {% comment %} Product Info {% endcomment %}
    <div class="product-card-simple__info">
      <div class="product-card-simple__title-row">
        <h3 class="product-card-simple__title">
          {{ product.title }}
        </h3>

        {%- if settings.quick_add and product.available -%}
          <button
            type="button"
            class="mobile-quick-add-btn"
            aria-label="{{ 'actions.add' | t }}"
            data-product-url="{{ product.url }}"
            data-product-title="{{ product.title | escape }}"
          >
            {{- 'icon_quick_add_button_mobile.svg' | inline_asset_content -}}
          </button>
        {%- endif -%}
      </div>

      <div class="product-card-simple__price">
        {%- if product.compare_at_price > product.price -%}
          <span class="product-card-simple__price-sale">
            {{ product.price | money }}
          </span>
          <span class="product-card-simple__price-compare">
            {{ product.compare_at_price | money }}
          </span>
        {%- else -%}
          <span class="product-card-simple__price-regular">
            {{ product.price | money }}
          </span>
        {%- endif -%}
      </div>
    </div>
  </a>

  {%- liquid
    assign erp_tag = nil
    assign erp_ref = nil
    for tag in product.tags
      assign tag_parts = tag | split: '-'
      if tag_parts.size == 2 and tag_parts[0].size > 3
        assign erp_tag = tag
        assign erp_ref = tag_parts[0]
        break
      endif
    endfor
  -%}

  <div class="product-card-simple__swatches mobile-only">
    {%- render 'color-siblings', product: product, erp_ref: erp_ref, mode: 'card' -%}
  </div>

  {% comment %} Quick Add Component for modal trigger (hidden, used by mobile '+' button) {% endcomment %}
  {%- if settings.quick_add and product.available -%}
    {% render 'quick-add', product: product, section_id: section_id %}
  {%- endif -%}
</product-card>

{% stylesheet %}
  .product-card-simple {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .product-card-simple__link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    flex: 0 0 auto;
  }

  .product-card-simple__media {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: visible;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5-15));
  }

  /* Show quick-add on hover */
  .product-card-simple__media:hover .quick-add-custom,
  .product-card-simple__media:focus-within .quick-add-custom {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: all;
  }

  .product-card-simple__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100% !important;
    min-height: 100%;
    max-height: 100%;
    object-fit: cover;
    display: block;
  }

  .product-card-simple__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-card-simple__placeholder .placeholder-svg {
    width: 60%;
    height: auto;
    opacity: 0.2;
  }

  /* Badge */
  .product-card-simple__badge {
    position: absolute;
    top: var(--padding-sm, 12px);
    left: var(--padding-sm, 12px);
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-family: var(--font-body--family);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 4px 8px;
    line-height: 1;
  }

  /* Product Info */
  .product-card-simple__info {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs, 4px);
    padding-top: var(--padding-sm, 12px);
    padding-bottom: 4px;
  }

  .product-card-simple__title {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm, 14px);
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-foreground);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-card-simple__title-row {
    display: contents;
  }

  @media screen and (max-width: 749px) {
    .product-card-simple__title-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 8px;
      width: 100%;
    }

    .product-card-simple__title-row .product-card-simple__title {
      flex: 1;
      min-width: 0;
    }

    .product-card-simple .mobile-quick-add-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 20px;
      height: 20px;
      padding: 0;
      margin-top: 2px;
      background: none;
      border: none;
      border-radius: 4px;
      color: var(--color-foreground, #1a1a1a);
      cursor: pointer;
    }

    .product-card-simple .mobile-quick-add-btn svg {
      width: 20px;
      height: 20px;
    }
  }

  .product-card-simple__price {
    display: flex;
    align-items: center;
    gap: var(--gap-xs, 8px);
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm, 14px);
  }

  .product-card-simple__price-regular {
    color: var(--color-foreground);
  }

  .product-card-simple__price-sale {
    color: var(--color-foreground);
    font-weight: 500;
  }

  .product-card-simple__price-compare {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-40-60));
    text-decoration: line-through;
  }

  @media screen and (max-width: 749px) {
    .product-card-simple__price {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }
  }

  /* Swatches for carousel - Mobile only */
  .product-card-simple__swatches {
    padding-bottom: 8px;
    width: 100%;
    position: relative;
    z-index: 2;
    overflow: visible;
  }

  .mobile-only {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .mobile-only {
      display: block;
    }

    .product-card-simple__swatches .variant-option {
      margin-bottom: 0;
      overflow: visible;
    }

    .product-card-simple__swatches .variant-option__swatch {
      margin-bottom: 0;
      overflow: visible;
    }

    .product-card-simple__swatches .variant-option__button-label--has-swatch {
      width: 16px;
      height: 24px; /* Increased height to contain the underline */
      border-radius: 0;
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      overflow: visible;
    }

    .product-card-simple__swatches .swatch-rounded {
      border-radius: 0 !important;
    }

    .product-card-simple__swatches .swatch {
      width: 16px;
      height: 16px;
      border-radius: 0 !important;
      display: block;
      flex: 0 0 16px;
    }

    /* Active swatch underline at 80% - Perfectly centered */
    .product-card-simple__swatches .variant-option__button-label--has-swatch:has(input:checked)::after {
      content: '';
      position: absolute;
      bottom: 2px;
      left: 50%;
      transform: translateX(-50%);
      width: 80%;
      height: 1.5px;
      background-color: var(--color-foreground, #1a1a1a);
      z-index: 3;
    }

    .product-card-simple__swatches swatches-variant-picker-component form {
      padding-bottom: 0px;
      overflow: visible;
    }

    .product-card-simple__swatches .overflow-list__container {
      gap: 10px;
      overflow: visible;
    }

    .product-card-simple__swatches overflow-list {
      display: block;
      overflow: visible;
    }

    /* Important: Force visibility inside the shadow DOM of overflow-list */
    .product-card-simple__swatches overflow-list::part(list),
    .product-card-simple__swatches overflow-list::part(overflow-list),
    .product-card-simple__swatches overflow-list::part(overflow) {
      overflow: visible !important;
    }
  }
{% endstylesheet %}

{%- doc -%}
  Renders a price filter.

  @param {object} filter - The filter object to render.
  @param {string} filter_style - The filter style, can be 'horizontal' or 'vertical'.
  @param {boolean} [autofocus] - Whether to autofocus the filter.
  @param {boolean} [should_render_clear] - Whether to render the clear button.

  @example
  {% render 'price-filter', filter: filter, filter_style: 'vertical' %}
{%- enddoc -%}

{% assign range_min_cents = filter.range_min | default: 0 %}
{% assign range_max_cents = filter.range_max | default: 1 %}
{% assign range_min_units = range_min_cents | divided_by: 100.0 %}
{% assign range_max_units = range_max_cents | divided_by: 100.0 %}

<accordion-custom
  class="facets__item"
  {% if filter_style == 'horizontal' %}
    data-disable-animation-on-desktop="true"
    data-close-with-escape="true"
  {% endif %}

  open-by-default-on-mobile
  {% if filter_style == 'vertical' %}
    open
    open-by-default-on-desktop
  {% endif %}
>
  <details
    class="facets__panel"
    {% if filter_style == 'horizontal' %}
      data-auto-close-details="desktop"
    {% endif %}
  >
    <summary class="facets__summary">
      <span class="facets__label">{{ filter.label }}</span>
      <facet-status-component class="facets__status">
        <template ref="moneyFormat">{{ shop.money_with_currency_format }}</template>

        <span
          class="hide-when-empty"
          ref="facetStatus"
          data-currency="{{ localization.country.currency.iso_code }}"
          data-range-min="{{ range_min_cents }}"
          data-range-max="{{ range_max_cents }}"
        >
          {%- if filter.min_value.value != null or filter.max_value.value != null %}
            {%- if filter.min_value.value != null and filter.max_value.value != null %}
              {{- filter.min_value.value | money_with_currency | strip_html -}}
              –
              {{- filter.max_value.value | money_with_currency | strip_html -}}
            {%- elsif filter.min_value.value != null -%}
              {{ filter.min_value.value | money_with_currency | strip_html }}–{{ filter.range_max | money_with_currency | strip_html }}

            {%- elsif filter.max_value.value != null -%}
              {{- range_min_cents | money_with_currency | strip_html -}}
              –
              {{- filter.max_value.value | money_with_currency | strip_html -}}
            {%- endif -%}
          {%- endif -%}
        </span>
      </facet-status-component>
      <span class="svg-wrapper icon-caret icon-animated">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </summary>
    <floating-panel-component
      {% unless filter_style == 'vertical' %}
        data-close-on-resize
      {% endunless %}
      class="facets__panel-content details-content{% if filter_style == 'horizontal' %} color-{{ settings.popover_color_scheme }}{% endif %}"
    >
      {% assign min_value_cents = filter.min_value.value | default: range_min_cents %}
      {% assign max_value_cents = filter.max_value.value | default: range_max_cents %}
      {% if min_value_cents < range_min_cents %}
        {% assign min_value_cents = range_min_cents %}
      {% endif %}
      {% if min_value_cents > range_max_cents %}
        {% assign min_value_cents = range_max_cents %}
      {% endif %}
      {% if max_value_cents < range_min_cents %}
        {% assign max_value_cents = range_min_cents %}
      {% endif %}
      {% if max_value_cents > range_max_cents %}
        {% assign max_value_cents = range_max_cents %}
      {% endif %}
      {% if min_value_cents > max_value_cents %}
        {% assign min_value_cents = max_value_cents %}
      {% endif %}
      {% assign min_value_units = min_value_cents | divided_by: 100.0 %}
      {% assign max_value_units = max_value_cents | divided_by: 100.0 %}
      {% assign min_input_max_value = max_value_units %}
      {% assign max_input_min_value = min_value_units %}
      {% assign range_span_units = range_max_units | minus: range_min_units %}
      {% if range_span_units == 0 %}
        {% assign range_span_units = 1 %}
      {% endif %}
      {% assign slider_step = 1000 %}
      {% if range_span_units <= 1000 %}
        {% assign slider_step = 1 %}
      {% elsif range_span_units <= 10000 %}
        {% assign slider_step = 100 %}
      {% endif %}
      {% assign range_start_percent = min_value_units | minus: range_min_units | times: 100.0 | divided_by: range_span_units %}
      {% assign range_end_percent = max_value_units | minus: range_min_units | times: 100.0 | divided_by: range_span_units %}
      {% assign range_width_percent = range_end_percent | minus: range_start_percent %}

      <price-facet-component
        class="price-facet"
        id="facet-inputs-{{ filter.param_name | escape | replace: '.', '-' }}"
        data-range-max="{{ range_max_units }}"
        data-range-min="{{ range_min_units }}"
        data-currency="{{ localization.country.currency.iso_code }}"
        data-money-format="{{ shop.money_with_currency_format | escape }}"
        data-minor-unit-factor="100"
        on:change="/updatePriceFilterAndResults"
      >
        <div class="price-facet__range-values" aria-hidden="true">
          <span class="price-facet__range-value" ref="minLabel">
            {{ min_value_cents | money_with_currency | strip_html }}
          </span>
          <span class="price-facet__range-value" ref="maxLabel">
            {{ max_value_cents | money_with_currency | strip_html }}
          </span>
        </div>

        <div class="price-facet__slider" ref="slider">
          <div class="price-facet__slider-track"></div>
          <div
            class="price-facet__slider-range"
            ref="activeRange"
            style="left: {{ range_start_percent }}%; width: {{ range_width_percent }}%;"
          ></div>

          <input
            class="price-facet__range-input price-facet__range-input--min"
            type="range"
            min="{{ range_min_units }}"
            max="{{ range_max_units }}"
            step="{{ slider_step }}"
            value="{{ min_value_units }}"
            ref="minRange"
            aria-label="{{ filter.label }} mínimo"
          >

          <input
            class="price-facet__range-input price-facet__range-input--max"
            type="range"
            min="{{ range_min_units }}"
            max="{{ range_max_units }}"
            step="{{ slider_step }}"
            value="{{ max_value_units }}"
            ref="maxRange"
            aria-label="{{ filter.label }} máximo"
          >
        </div>

        <div class="visually-hidden">
          <input
            name="{{ filter.min_value.param_name }}"
            id="{{ filter.label | escape }}-GTE"
            {%- if filter.min_value.value -%}
              value="{{ min_value_units }}"
            {%- endif -%}
            type="text"
            inputmode="decimal"
            placeholder="{{ range_min_units }}"
            data-min="{{ range_min_units }}"
            data-max="{{ min_input_max_value }}"
            ref="minInput"
            autocomplete="off"
            {% if autofocus %}
              autofocus
            {% endif %}
          >

          <input
            name="{{ filter.max_value.param_name }}"
            id="{{ filter.label | escape }}-LTE"
            {%- if filter.max_value.value -%}
              value="{{ max_value_units }}"
            {%- endif -%}
            type="text"
            inputmode="decimal"
            placeholder="{{ range_max_units }}"
            data-min="{{ max_input_min_value }}"
            data-max="{{ range_max_units }}"
            ref="maxInput"
            autocomplete="off"
            {% if autofocus %}
              autofocus
            {% endif %}
          >
        </div>

        <div class="price-facet__highest-price">
          {%- assign formatted_highest_price = range_max_cents | money_with_currency -%}
          {{ 'content.price_filter_html' | t: price: formatted_highest_price }}
        </div>

        {% if filter.min_value.value != null or filter.max_value.value != null %}
          {% assign has_active_values = true %}
        {% endif %}

        {% if should_render_clear %}
          <facet-clear-component
            class="clear-filter"
            tabindex="{% if has_active_values %}0{% else %}-1{% endif %}"
            on:click="/clearFilter"
            on:keydown="/clearFilter"
          >
            <div
              class="facets__clear {% if has_active_values %}facets__clear--active{% endif %}"
              ref="clearButton"
            >
              {{- 'actions.clear' | t -}}
            </div>
          </facet-clear-component>
        {% endif %}
      </price-facet-component>
    </floating-panel-component>
  </details>
</accordion-custom>

{% stylesheet %}
  /* Price filter */
  .price-facet {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
  }

  .price-facet__range-values {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--gap-md);
    padding: 0 var(--padding-xs);
  }

  .price-facet__range-value {
    color: rgb(var(--color-foreground-rgb) / 0.75);
    font-size: var(--font-paragraph--size);
  }

  .price-facet__slider {
    position: relative;
    height: 28px;
    margin: 0 var(--padding-xs);
  }

  .price-facet__slider-track,
  .price-facet__slider-range {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    height: 2px;
    border-radius: 999px;
  }

  .price-facet__slider-track {
    inset-inline: 0;
    background: rgb(var(--color-foreground-rgb) / 0.2);
  }

  .price-facet__slider-range {
    background: rgb(var(--color-foreground-rgb));
  }

  .price-facet__range-input {
    position: absolute;
    inset: 0;
    width: 100%;
    margin: 0;
    background: transparent;
    pointer-events: none;
    -webkit-appearance: none;
    appearance: none;
  }

  .price-facet__range-input::-webkit-slider-runnable-track {
    height: 2px;
    background: transparent;
  }

  .price-facet__range-input::-moz-range-track {
    height: 2px;
    background: transparent;
  }

  .price-facet__range-input::-webkit-slider-thumb {
    width: 16px;
    height: 16px;
    border: 1px solid rgb(var(--color-foreground-rgb));
    border-radius: 50%;
    background: rgb(var(--color-background-rgb));
    pointer-events: auto;
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
    margin-top: -7px;
  }

  .price-facet__range-input::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: 1px solid rgb(var(--color-foreground-rgb));
    border-radius: 50%;
    background: rgb(var(--color-background-rgb));
    pointer-events: auto;
    appearance: none;
    cursor: pointer;
  }

  .price-facet__range-input:focus-visible::-webkit-slider-thumb {
    outline: 2px solid rgb(var(--color-foreground-rgb));
    outline-offset: 2px;
  }

  .price-facet__range-input:focus-visible::-moz-range-thumb {
    outline: 2px solid rgb(var(--color-foreground-rgb));
    outline-offset: 2px;
  }

  .price-facet__highest-price {
    padding: var(--padding-xs) var(--padding-xs) var(--padding-sm);
  }

  .facets--horizontal .facets__panel-content:has(.price-facet) {
    min-width: 360px;
  }

  .facets--horizontal .price-facet__highest-price {
    padding: 0 var(--padding-xs) var(--padding-xs);
  }
{% endstylesheet %}

{%- doc -%}
  Renders CSS variables for spacing (padding and margin) styles with responsive scaling.
  Intended for blocks and sections that provide values for all the referenced settings.

  @param {object} settings - The block or section settings object containing spacing values

  @example
  <div class="spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
{%- enddoc -%}
{%- liquid
  assign scale_min = 20
  assign keys = 'padding-block-start,padding-block-end,padding-inline-start,padding-inline-end,padding_top,padding_bottom,padding_left,padding_right' | split: ','
  assign unit = settings.padding_unit | default: 'px'

  for key in keys
    assign value = settings[key]

    if value != blank
      echo '--'
      echo key | replace: '_', '-'
      echo ': '

      if unit == 'responsive'
        assign mobile_key = key | append: '_mobile'
        assign mobile_value = settings[mobile_key]
        if mobile_value == blank
          assign mobile_key = key | append: '-mobile'
          assign mobile_value = settings[mobile_key]
        endif
        render 'render-responsive-spacing', unit: 'responsive', desktop_value: value, mobile_value: mobile_value
      else
        if value > scale_min
          echo 'max('
          echo scale_min
          echo 'px, calc(var(--spacing-scale, 1.0) * '
          echo value
          echo 'px))'
        else
          echo value
          echo 'px'
        endif
      endif

      echo ';'
    endif
  endfor
-%}

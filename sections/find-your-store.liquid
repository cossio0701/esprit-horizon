    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de la seccion",
      "options": [
        { "value": "page-width", "label": "Ancho de pagina" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",

<script src="{{ 'registration-modal.js' | asset_url }}" type="module"></script>

<registration-modal
  id="registration-modal-{{ section.id }}"
  {% if section.settings.close_color_on_image != blank %}
    style="--close-color-on-image: {{ section.settings.close_color_on_image }}"
  {% endif %}
>
  <dialog
    class="registration-modal color-{{ settings.popover_color_scheme }}"
    ref="dialog"
    role="dialog"
    aria-modal="true"
    aria-label="Leads Modal"
    scroll-lock
  >
    <button
      ref="closeButton"
      on:click="/closeDialog"
      class="button button-unstyled close-button registration-modal__close"
      aria-label="{{ 'accessibility.close_dialog' | t }}"
    >
      {{- 'icon-close.svg' | inline_asset_content -}}
    </button>

    <div class="registration-modal__inner">
      {%- comment -%} LEFT - Imagen desktop (oculta en mobile) {%- endcomment -%}
      <div class="registration-modal__media">
        {%- if section.settings.left_image != blank -%}
          {{
            section.settings.left_image
            | image_url: width: 800
            | image_tag: loading: 'lazy', class: 'registration-modal__image', alt: section.settings.left_image.alt
            | escape
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'registration-modal__image registration-modal__image--placeholder' }}
        {%- endif -%}
      </div>

      {%- comment -%} RIGHT - Form {%- endcomment -%}
      <div class="registration-modal__content">
        {%- comment -%} Banner imagen mobile (oculto en desktop) {%- endcomment -%}
        {%- if section.settings.left_image_mobile != blank -%}
          <div class="registration-modal__media-mobile">
            {{
              section.settings.left_image_mobile
              | image_url: width: 600
              | image_tag:
                loading: 'lazy',
                class: 'registration-modal__image-mobile',
                alt: section.settings.left_image_mobile.alt
              | escape
            }}
          </div>
        {%- endif -%}

        {%- comment -%} Success state {%- endcomment -%}
        <div class="registration-modal__success" hidden tabindex="-1">
          {%- if section.settings.success_image != blank or section.settings.success_image_mobile != blank -%}
            <picture>
              {%- if section.settings.success_image_mobile != blank -%}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ section.settings.success_image_mobile | image_url: width: 600 }}"
                >
              {%- endif -%}
              {%- if section.settings.success_image != blank -%}
                {{
                  section.settings.success_image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    class: 'registration-modal__success-image',
                    alt: section.settings.success_image.alt
                  | escape
                }}
              {%- elsif section.settings.success_image_mobile != blank -%}
                {{
                  section.settings.success_image_mobile
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    class: 'registration-modal__success-image',
                    alt: section.settings.success_image_mobile.alt
                  | escape
                }}
              {%- endif -%}
            </picture>
          {%- endif -%}
        </div>

        {%- comment -%} Form {%- endcomment -%}
        <div class="registration-modal__form-wrapper">
          <form
            class="registration-modal__form"
            novalidate
          >
            <div class="registration-modal__field">
              <label for="registration-name-{{ section.id }}"> Nombre </label>
              <input
                id="registration-name-{{ section.id }}"
                type="text"
                name="customer[first_name]"
                autocomplete="given-name"
                placeholder="Ingresa tu nombre completo"
                required
              >
            </div>

            <div class="registration-modal__field">
              <label for="registration-email-{{ section.id }}"> Correo electr&#243;nico </label>
              <input
                id="registration-email-{{ section.id }}"
                type="email"
                name="customer[email]"
                autocomplete="email"
                placeholder="correo@gmail.com"
                required
              >
            </div>

            <div class="registration-modal__field">
              <label for="registration-phone-{{ section.id }}"> Celular </label>
              <input
                id="registration-phone-{{ section.id }}"
                type="tel"
                name="customer[phone]"
                autocomplete="tel"
                placeholder="Ingresa tu celular"
                required
              >
            </div>

            <div class="registration-modal__field">
              <label for="registration-dob-{{ section.id }}"> Fecha de nacimiento </label>
              <input
                id="registration-dob-{{ section.id }}"
                type="date"
                name="customer[note][fecha_nacimiento]"
                required
              >
            </div>

            <div class="registration-modal__field">
              <label for="registration-id-{{ section.id }}"> Identificaci&#243;n </label>
              <input
                id="registration-id-{{ section.id }}"
                type="text"
                name="customer[note][identificacion]"
                placeholder="N&#250;mero de identificaci&#243;n"
                required
              >
            </div>

            <div class="registration-modal__legal">
              <input
                id="registration-legal-{{ section.id }}"
                type="checkbox"
                name="customer[accepts_marketing]"
                required
              >
              <label for="registration-legal-{{ section.id }}">
                {%- if section.settings.legal_link != blank -%}
                  {{ section.settings.legal_text }}
                  <a href="{{ section.settings.legal_link }}" target="_blank" rel="noopener noreferrer">
                    {{ section.settings.legal_link_text }}
                  </a>
                {%- else -%}
                  {{ section.settings.legal_text }}
                {%- endif -%}
              </label>
            </div>

            <button type="submit" class="button registration-modal__submit">
              {{ section.settings.button_text | default: 'Registrarse' }}
            </button>
          </form>
        </div>
      </div>
    </div>
  </dialog>
</registration-modal>

{% stylesheet %}
  /* =============================================
     MOBILE FIRST
     ============================================= */

  /* -- Dialog shell -- */
  .registration-modal {
    padding: 0;
    border: var(--style-border-popover, none);
    border-radius: 0;
    box-shadow: 0 8px 40px rgb(var(--color-shadow-rgb) / var(--opacity-15));
    width: min(92vw, 480px);
    max-height: 90dvh;
    overflow: hidden;
  }

  .registration-modal[open] {
    display: flex;
    animation: modalSlideInTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .registration-modal.dialog-closing {
    animation: modalSlideOutTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .registration-modal::backdrop {
    background: rgb(var(--color-foreground-rgb) / var(--opacity-40));
  }

  /* -- Close button -- */
  .registration-modal__close {
    position: absolute;
    top: var(--margin-2xs);
    right: var(--margin-2xs);
    z-index: var(--layer-raised);
    transition: transform 0.15s var(--animation-timing-bounce);
  }

  .registration-modal__close:active {
    transform: scale(0.8);
  }

  .registration-modal__close {
    color: var(--close-color-on-image, currentColor);
  }

  registration-modal.is-success .registration-modal__close {
    color: var(--close-color-on-image, currentColor);
  }

  /* -- Inner grid (mobile: una columna) -- */
  .registration-modal__inner {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
    min-height: 0;
    flex: 1;
  }

  /* -- Imagen desktop (oculta en mobile) -- */
  .registration-modal__media {
    display: none;
    position: relative;
    overflow: hidden;
  }

  .registration-modal__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .registration-modal__image--placeholder {
    background: rgb(var(--color-foreground-rgb) / var(--opacity-5));
  }

  /* -- Banner imagen mobile (oculto en desktop) -- */
  .registration-modal__media-mobile {
    width: 100%;
    overflow: hidden;
    flex-shrink: 0;
    margin-bottom: var(--margin-lg);
  }

  .registration-modal__image-mobile {
    display: block;
    width: 100%;
    object-fit: cover;
  }

  /* -- Content (mobile) -- */
  .registration-modal__content {
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding: 0;
    min-height: 0;
  }

  /* -- Success state -- */
  .registration-modal__success[hidden] {
    display: none;
  }

  .registration-modal__success {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--gap-md);
    height: 100%;
  }

  registration-modal.is-success .registration-modal {
    height: 360px;
  }

  registration-modal.is-success .registration-modal__inner {
    grid-template-columns: 1fr;
    height: 100%;
  }

  registration-modal.is-success .registration-modal__media,
  registration-modal.is-success .registration-modal__media-mobile {
    display: none;
  }

  registration-modal.is-success .registration-modal__content {
    padding: 0;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  registration-modal.is-success .registration-modal__success {
    position: absolute;
    inset: 0;
  }

  .registration-modal__success-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* -- Form wrapper -- */
  .registration-modal__form-wrapper[hidden] {
    display: none;
  }

  .registration-modal__form-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    padding-inline: var(--padding-xl);
    padding-bottom: var(--padding-xl);
    transition: opacity 0.15s var(--animation-easing);
  }

  .registration-modal__form-wrapper.is-hiding {
    opacity: 0;
  }

  /* -- Title -- */
  .registration-modal__title {
    font-family: var(--font-h2--family);
    font-size: var(--font-h2--size);
    font-weight: var(--font-h2--weight);
    font-style: var(--font-h2--style);
    line-height: var(--font-h2--line-height);
    letter-spacing: var(--font-h2--letter-spacing);
    text-transform: var(--font-h2--case);
    color: var(--color-foreground);
    margin: 0 0 var(--margin-sm);
  }

  /* -- Form -- */
  .registration-modal__form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    flex: 1;
  }

  /* -- hCaptcha (Shopify auto-inject, oculto porque el submit es manejado por JS) -- */
  .registration-modal .h-captcha {
    display: none;
  }

  /* -- Field -- */
  .registration-modal__field {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
  }

  .registration-modal__field label {
    font-size: var(--font-size--xs);
    font-weight: 600;
    color: var(--color-foreground);
  }

  .registration-modal__field input {
    width: 100%;
    padding-block: var(--padding-xs);
    padding-inline: var(--padding-sm);
    background: var(--color-input-background);
    color: var(--color-input-text);
    border: var(--style-border-width-inputs, 1px) solid var(--color-input-border);
    border-radius: 0;
    font-family: inherit;
    font-size: var(--font-size);
    line-height: var(--line-height--body);
    transition: border-color 0.2s var(--animation-easing);
    box-sizing: border-box;
  }

  .registration-modal__field input::placeholder {
    color: rgb(var(--color-foreground-rgb) / 0.35);
  }

  .registration-modal__field input[type='date'] {
    color: rgb(var(--color-foreground-rgb) / 0.35);
  }

  .registration-modal__field input[type='date']:valid {
    color: var(--color-input-text);
  }

  .registration-modal__field input:focus-visible {
    outline: none;
    border-color: var(--color-foreground);
  }

  .registration-modal__field input[aria-invalid='true'] {
    border-color: #cc0000;
  }

  .registration-modal__error {
    font-size: var(--font-size--xs);
    color: #cc0000;
  }

  /* -- Legal checkbox -- */
  .registration-modal__legal {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--gap-2xs);
    margin-block-start: var(--margin-2xs);
  }

  .registration-modal__legal input[type='checkbox'] {
    grid-column: 1;
    grid-row: 1;
    margin-block-start: 0.2em;
    accent-color: var(--color-foreground);
    width: 1em;
    height: 1em;
    cursor: pointer;
  }

  .registration-modal__legal label {
    grid-column: 2;
    grid-row: 1;
    font-size: var(--font-size--xs);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-80));
    line-height: var(--line-height--body);
    cursor: pointer;
  }

  .registration-modal__legal .registration-modal__error {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .registration-modal__legal a {
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* -- Submit button -- */
  .registration-modal__submit {
    margin-block-start: var(--margin-lg);
    width: fit-content;
    padding-block: 8px;
    padding-inline: var(--padding-2xl);
    text-transform: uppercase;
    transition: opacity 0.15s var(--animation-easing);
  }

  .registration-modal__submit[aria-busy='true'] {
    opacity: 0.5;
    cursor: wait;
    pointer-events: none;
  }

  /* =============================================
     DESKTOP (min-width: 750px)
     ============================================= */
  @media screen and (min-width: 750px) {
    .registration-modal {
      width: min(92vw, 900px);
      max-height: 90vh;
    }

    .registration-modal__inner {
      grid-template-columns: 1fr 1fr;
    }

    .registration-modal__media {
      display: block;
    }

    .registration-modal__media-mobile {
      display: none;
    }

    .registration-modal__close {
      color: currentColor;
    }

    registration-modal.is-success .registration-modal {
      height: 90vh;
    }

    .registration-modal__content {
      padding: var(--padding-3xl) var(--padding-xl);
    }

    .registration-modal__form-wrapper {
      padding: 0;
    }
  }

  /* -- Animations -- */
  @keyframes successFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .registration-modal__success:not([hidden]) {
    animation: successFadeIn 0.3s var(--animation-easing) forwards;
  }

  @keyframes modalSlideInTop {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes modalSlideOutTop {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-12px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Leads Modal",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Imagen del formulario"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Desktop"
    },
    {
      "type": "image_picker",
      "id": "left_image_mobile",
      "label": "Mobile"
    },
    {
      "type": "header",
      "content": "Imagen de éxito"
    },
    {
      "type": "image_picker",
      "id": "success_image",
      "label": "Desktop"
    },
    {
      "type": "image_picker",
      "id": "success_image_mobile",
      "label": "Mobile"
    },
    {
      "type": "header",
      "content": "Formulario"
    },
    {
      "type": "textarea",
      "id": "legal_text",
      "label": "Texto del checkbox legal",
      "default": "Acepto los"
    },
    {
      "type": "text",
      "id": "legal_link_text",
      "label": "Texto del enlace legal",
      "default": "terminos y condiciones"
    },
    {
      "type": "url",
      "id": "legal_link",
      "label": "URL del enlace legal"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto del botón",
      "default": "Registrarse"
    },
    {
      "type": "header",
      "content": "Estilos"
    },
    {
      "type": "color",
      "id": "close_color_on_image",
      "label": "Color del botón cerrar sobre imagen"
    }
  ],
  "presets": [
    {
      "name": "Leads Modal"
    }
  ]
}
{% endschema %}

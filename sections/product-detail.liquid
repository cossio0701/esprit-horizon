<section class="pdp-main-container" data-product-grid-content>
  {% for block in section.blocks %}
    {% render block %}
  {% endfor %}
</section>

<style>
  .pdp-main-container {
    display: flex;
    @media screen and (min-width: 1024px) {
      gap: 32px;
    }
    max-width: 1830px;
    margin: 0 auto;
    margin-left: 40px;
    margin-right: 40px;
  }

  .pdp-main-container .section-variant-gallery {
    width: 55%;
  }

  .pdp-main-container .product-details {
    width: 45%;
  }

  @media (max-width: 1024px) {
    .pdp-main-container {
      flex-direction: column;
      padding: 0;
      margin: 0;
    }

    .pdp-main-container .section-variant-gallery {
      width: 100%;
    }

    .pdp-main-container .product-details {
      width: 100%;
      padding: 0 1rem;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Product Detail",
  "class": "product-detail",

  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "_product-gallery-pdp"
    },
    {
      "type": "_product-details"
    }
  ],
  "presets": [{ "name": "Custom Product Detail" }]
}
{% endschema %}

{% comment %}
  Featured Collection Hero Section
  Two-column layout: hero image with text overlay + product grid from collection
{% endcomment %}

{% liquid
  assign color_scheme = section.settings.color_scheme | default: 'scheme-1'
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_count | default: 4
%}

<div class="featured-collection-hero color-{{ color_scheme }}">
  <div class="section-background color-{{ color_scheme }}"></div>

  <div
    class="featured-collection-hero__container section section--{{ section.settings.section_width }} color-{{ color_scheme }} spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% comment %} LEFT COLUMN: Hero Image {% endcomment %}
    <div class="featured-collection-hero__image-column">
      <div class="featured-collection-hero__image-wrapper">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              class: 'featured-collection-hero__image',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(max-width: 749px) 100vw, 50vw'
          }}
        {%- else -%}
          <div class="featured-collection-hero__placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}

        {% comment %} Text Overlay {% endcomment %}
        <div class="featured-collection-hero__overlay">
          <div class="featured-collection-hero__text">
            {%- if section.settings.title != blank -%}
              <h2 class="featured-collection-hero__title" style="color: {{ section.settings.title_color }};">
                {{ section.settings.title }}
              </h2>
            {%- endif -%}

            {%- if section.settings.subtitle != blank -%}
              <p class="featured-collection-hero__subtitle" style="color: {{ section.settings.subtitle_color }};">
                {%- if collection != blank -%}
                  <a href="{{ collection.url }}" class="featured-collection-hero__link" style="color: {{ section.settings.subtitle_color }};">
                    {{ section.settings.subtitle }}
                  </a>
                {%- else -%}
                  {{ section.settings.subtitle }}
                {%- endif -%}
              </p>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>

    {% comment %} RIGHT COLUMN: Product Grid from Collection {% endcomment %}
    <div class="featured-collection-hero__products-column">
      <div class="featured-collection-hero__products-grid">
        {%- if collection != blank and collection.products.size > 0 -%}
          {%- for product in collection.products limit: products_to_show -%}
            <div class="featured-collection-hero__product-item">
              {% comment %} Product Card - Direct structure like product-card {% endcomment %}
              <product-card class="product-card fch-card" data-product-id="{{ product.id }}">
                <a href="{{ product.url }}" class="product-card__link">
                  <span class="visually-hidden">{{ product.title }}</span>
                </a>
                <div class="product-card__content fch-card__content">
                  {% comment %} Image Gallery {% endcomment %}
                  <div class="fch-gallery" data-product-id="{{ product.id }}" style="--quick-add-display: flex; --quick-add-mobile-display: flex;">
                    {%- if product.featured_media != blank -%}
                      <a href="{{ product.url }}" class="fch-gallery__link">
                        {{
                          product.featured_media
                          | image_url: width: 600
                          | image_tag:
                            loading: 'lazy',
                            class: 'fch-gallery__image',
                            widths: '200, 300, 400, 500, 600',
                            sizes: '(max-width: 749px) 50vw, 25vw'
                        }}
                      </a>
                    {%- elsif product.images.first != blank -%}
                      <a href="{{ product.url }}" class="fch-gallery__link">
                        {{
                          product.images.first
                          | image_url: width: 600
                          | image_tag:
                            loading: 'lazy',
                            class: 'fch-gallery__image',
                            widths: '200, 300, 400, 500, 600',
                            sizes: '(max-width: 749px) 50vw, 25vw'
                        }}
                      </a>
                    {%- else -%}
                      <div class="fch-gallery__placeholder">
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {%- endif -%}

                    {% comment %} Sale Badge {% endcomment %}
                    {%- if product.compare_at_price > product.price -%}
                      <div class="fch-badge">
                        {%- assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
                        -{{ discount }}%
                      </div>
                    {%- endif -%}

                    {%- if product.available -%}
                      {% comment %} Quick Add Button {% endcomment %}
                      {% render 'quick-add', product: product, section_id: section.id %}
                    {%- else -%}
                      {% comment %} Sold Out Badge - same appearance as product-card badges {% endcomment %}
                      <div
                        class="fch-sold-out product-badges__badge product-badges__badge--rectangle color-{{ settings.badge_sold_out_color_scheme }}"
                        style="--badge-border-radius: {{ settings.badge_corner_radius }}px; --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};"
                      >
                        {{ 'content.product_badge_sold_out' | t }}
                      </div>
                    {%- endif -%}

                    {% comment %} PLP Variant Controller - Desktop (only if available) {% endcomment %}
                    {%- if product.available and product.variants.size > 0 -%}
                      {%- liquid
                        assign color_option = null
                        assign first_color = null
                        for option in product.options_with_values
                          assign swatch_count = option.values | map: 'swatch' | compact | size
                          if swatch_count > 0
                            assign color_option = option
                            assign first_color = option.values.first.name
                            break
                          endif
                        endfor

                        assign initial_variants = product.variants
                        if first_color
                          assign initial_variants = product.variants | where: 'option1', first_color
                          if initial_variants.size == 0
                            assign initial_variants = product.variants | where: 'option2', first_color
                          endif
                          if initial_variants.size == 0
                            assign initial_variants = product.variants
                          endif
                        endif

                        assign first_available_variant = null
                        for variant in initial_variants
                          if variant.available and first_available_variant == null
                            assign first_available_variant = variant
                            break
                          endif
                        endfor
                      -%}
                      <div class="plp-variant-controller fch-variant-controller" data-product-id="{{ product.id }}" data-first-variant-id="{{ first_available_variant.id }}" data-first-color="{{ first_color }}">
                        {% comment %} Tallas {% endcomment %}
                        <div class="plp-sizes" id="fch-sizes-{{ product.id }}">
                          {%- for variant in initial_variants -%}
                            {%- liquid
                              assign is_selected = false
                              if first_available_variant and variant.id == first_available_variant.id
                                assign is_selected = true
                              endif
                            -%}
                            <button
                              class="plp-size{% unless variant.available %} out{% endunless %}{% if is_selected %} active{% endif %}"
                              {% unless variant.available %}disabled{% endunless %}
                              data-variant-id="{{ variant.id }}"
                            >
                              {{ variant.option2 | default: variant.option1 }}
                            </button>
                          {%- endfor -%}
                        </div>

                        {% comment %} Colores {% endcomment %}
                        {%- if color_option -%}
                          <div class="plp-colors">
                            {%- for option_value in color_option.values -%}
                              {%- if option_value.swatch -%}
                                {%- liquid
                                  assign swatch_bg = null
                                  if option_value.swatch.image
                                    assign swatch_image_url = option_value.swatch.image | image_url: width: 80
                                    assign swatch_bg = 'url(' | append: swatch_image_url | append: ')'
                                  elsif option_value.swatch.color
                                    assign swatch_bg = 'rgb(' | append: option_value.swatch.color.rgb | append: ')'
                                  endif

                                  assign is_first = false
                                  if forloop.first
                                    assign is_first = true
                                  endif

                                  assign color_available = false
                                  for variant in product.variants
                                    if variant.option1 == option_value.name or variant.option2 == option_value.name
                                      if variant.available
                                        assign color_available = true
                                        break
                                      endif
                                    endif
                                  endfor
                                -%}
                                <button
                                  class="plp-color plp-color--swatch{% if is_first and color_available %} active{% endif %}{% unless color_available %} out{% endunless %}"
                                  data-color="{{ option_value.name }}"
                                  data-product-id="{{ product.id }}"
                                  data-available="{{ color_available }}"
                                  style="--swatch-bg: {{ swatch_bg }};"
                                  title="{{ option_value.name }}"
                                >
                                  <span class="visually-hidden">{{ option_value.name }}</span>
                                </button>
                              {%- endif -%}
                            {%- endfor -%}
                          </div>
                        {%- endif -%}

                        {% comment %} Botón Agregar {% endcomment %}
                        <div class="plp-row plp-row--button">
                          <button
                            class="plp-add-to-cart{% if first_available_variant %} ready{% endif %}"
                            data-product-id="{{ product.id }}"
                            {% unless first_available_variant %}disabled{% endunless %}
                          >
                            Agregar a la bolsa →
                          </button>
                        </div>

                        <script>
                          window.PLP = window.PLP || {};
                          window.PLP["{{ product.id }}"] = {
                            variants: [
                              {%- for v in product.variants -%}
                                {
                                  id: {{ v.id }},
                                  available: {{ v.available | json }},
                                  options: {{ v.options | json }},
                                  price: {{ v.price }},
                                  priceFormatted: "{{ v.price | money }}",
                                  compareAtPrice: {{ v.compare_at_price | default: 'null' }},
                                  compareAtPriceFormatted: "{{ v.compare_at_price | money }}",
                                  featured_media_id: {{ v.featured_media.id | default: 'null' }}
                                }{% unless forloop.last %},{% endunless %}
                              {%- endfor -%}
                            ]
                          };
                        </script>
                      </div>
                    {%- endif -%}
                  </div>

                  {% comment %} Product Info {% endcomment %}
                  <div class="fch-product-info">
                    <h3 class="fch-product-title">
                      <a href="{{ product.url }}">{{ product.title }}</a>
                    </h3>
                    <div class="fch-product-price">
                      {%- if product.compare_at_price > product.price -%}
                        <span class="fch-price-sale">{{ product.price | money }}</span>
                        <span class="fch-price-compare">{{ product.compare_at_price | money }}</span>
                      {%- else -%}
                        <span class="fch-price-regular">{{ product.price | money }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </product-card>
            </div>
          {%- endfor -%}

          {% comment %} Fill remaining if less products than requested {% endcomment %}
          {%- if collection.products.size < products_to_show -%}
            {%- assign remaining = products_to_show | minus: collection.products.size -%}
            {%- for i in (1..remaining) -%}
              <div class="featured-collection-hero__product-item featured-collection-hero__product-item--placeholder">
                <div class="featured-collection-hero__product-placeholder">
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        {%- else -%}
          {% comment %} Placeholders when no collection selected {% endcomment %}
          {%- for i in (1..products_to_show) -%}
            <div class="featured-collection-hero__product-item featured-collection-hero__product-item--placeholder">
              <div class="featured-collection-hero__product-placeholder">
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .featured-collection-hero__container.section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap-lg, 24px);
    align-items: stretch;
  }

  .featured-collection-hero__container.section--page-width {
    max-width: calc(var(--page-width) - var(--page-margin) * 2);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .featured-collection-hero__container.section--full-width {
    max-width: none;
    padding-inline: var(--page-margin);
  }

  /* Left Column - Hero Image */
  .featured-collection-hero__image-column {
    position: relative;
    grid-column: 1;
    grid-row: 1;
  }

  .featured-collection-hero__image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 500px;
    overflow: hidden;
  }

  .featured-collection-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .featured-collection-hero__placeholder {
    width: 100%;
    height: 100%;
    min-height: 500px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5-15));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .featured-collection-hero__placeholder .placeholder-svg {
    width: 50%;
    height: auto;
    opacity: 0.3;
  }

  /* Text Overlay */
  .featured-collection-hero__overlay {
    position: absolute;
    inset: 0;
    padding: var(--padding-lg, 32px);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
  }

  .featured-collection-hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs, 8px);
  }

  .featured-collection-hero__title {
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: var(--font-heading--weight, 400);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-foreground);
    margin: 0;
  }

  .featured-collection-hero__subtitle {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm, 14px);
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-foreground);
    margin: 0;
  }

  .featured-collection-hero__link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .featured-collection-hero__link:hover {
    text-decoration-thickness: 2px;
  }

  /* Right Column - Product Grid */
  .featured-collection-hero__products-column {
    display: flex;
    flex-direction: column;
    grid-column: 2;
    grid-row: 1;
  }

  .featured-collection-hero__products-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap-sm, 12px);
    height: 100%;
  }

  .featured-collection-hero__product-item {
    min-width: 0;
  }

  /* Product Card Styles */
  .featured-collection-hero__product-item .fch-card {
    display: block;
    height: 100%;
    width: 100%;
  }

  .fch-card__content {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* Gallery Styles */
  .fch-gallery {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: visible;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5-15));
  }

  .fch-gallery__link {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .fch-gallery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .fch-gallery__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fch-gallery__placeholder .placeholder-svg {
    width: 60%;
    height: auto;
    opacity: 0.2;
  }

  /* Badge */
  .fch-badge {
    position: absolute;
    top: var(--padding-sm, 12px);
    left: var(--padding-sm, 12px);
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-family: var(--font-body--family);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 4px 8px;
    line-height: 1;
    z-index: 5;
  }

  /* Sold Out Badge */
  .fch-sold-out {
    position: absolute;
    top: var(--padding-sm, 12px);
    right: var(--padding-sm, 12px);
    z-index: 5;
    border: none;
  }

  /* Product Info Styles */
  .fch-product-info {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs, 4px);
    padding-top: var(--padding-sm, 12px);
  }

  .fch-product-title {
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm, 14px);
    font-weight: 400;
    line-height: 1.4;
    margin: 0;
  }

  .fch-product-title a {
    color: var(--color-foreground);
    text-decoration: none;
  }

  .fch-product-title a:hover {
    text-decoration: underline;
  }

  .fch-product-price {
    display: flex;
    align-items: center;
    gap: var(--gap-xs, 8px);
    font-family: var(--font-body--family);
    font-size: var(--font-size--sm, 14px);
  }

  .fch-price-regular {
    color: var(--color-foreground);
  }

  .fch-price-sale {
    color: var(--color-foreground);
    font-weight: 500;
  }

  .fch-price-compare {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-40-60));
    text-decoration: line-through;
  }

  /* ========================================
     QUICK ADD - Featured Collection Hero
     Desktop: plp-variant-controller (hover overlay)
     Mobile: quick-add button (round icon)
     ======================================== */

  /* ---- MOBILE: Quick Add Button ---- */
  .fch-card .quick-add,
  .fch-card quick-add-component.quick-add {
    position: absolute;
    inset: auto;
    bottom: var(--padding-sm, 12px);
    right: var(--padding-sm, 12px);
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    padding: 0;
    z-index: 10;
    pointer-events: none;
    width: auto;
    height: auto;
  }

  .fch-card .quick-add__product-form-component,
  .fch-card .quick-add__product-form-component .shopify-product-form {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    height: auto;
  }

  .fch-card .quick-add__button,
  .fch-card .quick-add__button.quick-add__button--add,
  .fch-card .quick-add__button.quick-add__button--choose,
  .fch-card .button.quick-add__button {
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    padding: 0;
    background-color: var(--color-background, #fff);
    color: var(--color-foreground, #1a1a1a);
    border: none;
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    cursor: pointer;
    pointer-events: all;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .fch-card .quick-add__button:hover {
    background-color: var(--color-foreground, #1a1a1a);
    color: var(--color-background, #fff);
    transform: scale(1.05);
  }

  .fch-card .quick-add__button .add-to-cart-text {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin: 0;
    padding: 0;
  }

  .fch-card .quick-add__button .add-to-cart-icon,
  .fch-card .quick-add__button .svg-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
  }

  .fch-card .quick-add__button .add-to-cart-text__content {
    display: none !important;
    width: 0;
    opacity: 0;
  }

  /* Override ALL product-card.liquid rules that hide buttons */
  .fch-card.product-card .quick-add__button--add,
  .fch-card.product-card .quick-add__button--choose,
  .fch-card:has(.quick-add__product-form-component--single-option) .quick-add__button--add,
  .fch-card:has(.quick-add__product-form-component--single-option) .quick-add__button--choose,
  .fch-card:has(.quick-add__product-form-component--multi-option) .quick-add__button--add,
  .fch-card:has(.quick-add__product-form-component--multi-option) .quick-add__button--choose,
  .fch-card:has(.quick-add__product-form-component--single-variant) .quick-add__button--add,
  .fch-card:has(.quick-add__product-form-component--single-variant) .quick-add__button--choose,
  .fch-card:has(.quick-add__product-form-component--multi-variant) .quick-add__button--add,
  .fch-card:has(.quick-add__product-form-component--multi-variant) .quick-add__button--choose,
  .fch-card:has(swatches-variant-picker-component) .quick-add__button--add,
  .fch-card:has(swatches-variant-picker-component) .quick-add__button--choose,
  .fch-card:not(:has(swatches-variant-picker-component)) .quick-add__button--add,
  .fch-card:not(:has(swatches-variant-picker-component)) .quick-add__button--choose {
    display: flex !important;
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    padding: 0;
    border-radius: 50%;
  }

  /* ---- PLP Variant Controller (for FCH) ---- */
  .fch-variant-controller {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    background: rgba(255, 255, 255, 0.98);
    display: none;
    flex-direction: column;
    gap: 8px;
    padding: 14px 16px;
    z-index: 10;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .fch-gallery:hover .fch-variant-controller {
    opacity: 1;
    visibility: visible;
  }

  /* ---- DESKTOP: Show variant controller, hide quick-add ---- */
  @media screen and (min-width: 750px) {
    .fch-card .quick-add,
    .fch-card quick-add-component.quick-add {
      display: none !important;
    }

    .fch-variant-controller {
      display: flex;
    }

    .fch-quick-add-fallback {
      display: none;
    }
  }

  /* Force show button in mobile - multiple specific selectors to override product-card.liquid */
  .featured-collection-hero .fch-card .quick-add__button,
  .featured-collection-hero .product-card.fch-card .quick-add__button,
  .featured-collection-hero .product-card.fch-card .quick-add__button--add,
  .featured-collection-hero .product-card.fch-card .quick-add__button--choose,
  .featured-collection-hero__product-item .fch-card .quick-add__button,
  .featured-collection-hero__product-item .product-card .quick-add__button--add,
  .featured-collection-hero__product-item .product-card .quick-add__button--choose {
    display: flex !important;
    width: 40px !important;
    height: 40px !important;
    min-width: 40px !important;
    min-height: 40px !important;
    padding: 0 !important;
    border-radius: 50% !important;
    background-color: var(--color-background, #fff) !important;
    color: var(--color-foreground, #1a1a1a) !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12) !important;
  }

  /* ---- MOBILE: Show quick-add, hide variant controller ---- */
  @media screen and (max-width: 749px) {
    .fch-variant-controller {
      display: none !important;
    }

    /* Ensure quick-add container is visible */
    .fch-card .quick-add,
    .fch-card quick-add-component.quick-add,
    .featured-collection-hero .quick-add,
    .featured-collection-hero quick-add-component {
      display: flex !important;
      opacity: 1 !important;
      visibility: visible !important;
    }

    /* Ensure add-to-cart-component wrapper is visible */
    .fch-card add-to-cart-component,
    .featured-collection-hero add-to-cart-component {
      display: block !important;
      opacity: 1 !important;
      visibility: visible !important;
    }

    /* Ensure all button types are visible */
    .fch-card .quick-add__button,
    .fch-card .quick-add__button--add,
    .fch-card .quick-add__button--choose,
    .fch-card .button.quick-add__button,
    .fch-card add-to-cart-component .quick-add__button,
    .featured-collection-hero .quick-add__button,
    .featured-collection-hero .quick-add__button--add,
    .featured-collection-hero .quick-add__button--choose {
      display: flex !important;
      opacity: 1 !important;
      visibility: visible !important;
    }
  }

  /* Fallback button for single-variant products */
  .fch-quick-add-fallback {
    position: absolute;
    bottom: var(--padding-sm, 12px);
    right: var(--padding-sm, 12px);
    z-index: 15;
  }

  .fch-add-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background-color: var(--color-background, #fff);
    color: var(--color-foreground, #1a1a1a);
    border: none;
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .fch-add-button:hover {
    background-color: var(--color-foreground, #1a1a1a);
    color: var(--color-background, #fff);
    transform: scale(1.05);
  }

  .fch-add-button__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
  }

  .fch-add-button__icon svg {
    width: 100%;
    height: 100%;
  }

  /* Hide fallback when quick-add button exists */
  .fch-gallery:has(.quick-add__button) .fch-quick-add-fallback,
  .fch-gallery:has(.quick-add__button--add) .fch-quick-add-fallback,
  .fch-gallery:has(.quick-add__button--choose) .fch-quick-add-fallback {
    display: none;
  }

  /* Product Placeholder */
  .featured-collection-hero__product-placeholder {
    width: 100%;
    height: 100%;
    min-height: 200px;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5-15));
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 3 / 4;
  }

  .featured-collection-hero__product-placeholder .placeholder-svg {
    width: 60%;
    height: auto;
    opacity: 0.2;
  }

  /* Responsive - Mobile */
  @media screen and (max-width: 749px) {
    .featured-collection-hero__container.section {
      grid-template-columns: 1fr;
      gap: var(--gap-md, 16px);
    }

    .featured-collection-hero__image-column {
      grid-column: 1;
      grid-row: 1;
    }

    .featured-collection-hero__products-column {
      grid-column: 1;
      grid-row: 2;
    }

    .featured-collection-hero__image-wrapper {
      min-height: 400px;
    }

    .featured-collection-hero__overlay {
      padding: var(--padding-md, 20px);
    }

    .featured-collection-hero__title {
      font-size: clamp(1.75rem, 8vw, 2.5rem);
    }

    .featured-collection-hero__products-grid {
      gap: var(--gap-xs, 8px);
    }
  }

  /* Tablet */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .featured-collection-hero__image-wrapper {
      min-height: 450px;
    }

    .featured-collection-hero__title {
      font-size: clamp(1.75rem, 4vw, 2.5rem);
    }
  }
{% endstylesheet %}

{% javascript %}
  // FCH Quick Add - Opens modal for ALL products
  (function() {
    function init() {
      setupSwipeToClose();
      setupQuickAddClicks();
    }

    // Setup click handlers for ALL quick-add buttons in featured-collection-hero
    function setupQuickAddClicks() {
      document.querySelectorAll('.featured-collection-hero .fch-gallery').forEach(gallery => {
        gallery.addEventListener('click', async (e) => {
          const button = e.target.closest('.quick-add__button, .fch-add-button');
          if (!button) return;

          e.preventDefault();
          e.stopPropagation();

          console.log('[FCH] Quick add button clicked');

          // Get product URL from the quick-add-component or button data
          const quickAddComponent = gallery.querySelector('quick-add-component');
          const productUrl = quickAddComponent?.dataset?.productUrl || button.dataset?.productUrl;

          if (!productUrl) {
            console.error('[FCH] No product URL found');
            return;
          }

          console.log('[FCH] Opening modal for:', productUrl);

          // Try using the component's handleClick first
          if (quickAddComponent && typeof quickAddComponent.handleClick === 'function') {
            try {
              const fakeEvent = { preventDefault: () => {}, stopPropagation: () => {} };
              await quickAddComponent.handleClick(fakeEvent);
              console.log('[FCH] Used quick-add-component.handleClick');
              return;
            } catch (err) {
              console.log('[FCH] handleClick failed, using fallback:', err);
            }
          }

          // Fallback: open modal directly
          await window.FCHQuickAdd.openModal(productUrl, button);
        });
      });

      console.log('[FCH] Quick add click handlers set up');
    }

    window.FCHQuickAdd = {
      async open(button) {
        const productUrl = button.dataset.productUrl;
        if (!productUrl) {
          console.error('FCH Quick Add: No product URL');
          return;
        }

        // Find the quick-add-component in the same gallery
        const gallery = button.closest('.fch-gallery');
        if (gallery) {
          const quickAddComponent = gallery.querySelector('quick-add-component');
          if (quickAddComponent) {
            if (typeof quickAddComponent.handleClick === 'function') {
              const fakeEvent = { preventDefault: () => {} };
              try {
                await quickAddComponent.handleClick(fakeEvent);
                return;
              } catch (e) {
                console.log('handleClick failed, using fallback');
              }
            }
          }
        }

        // Fallback: Manual modal opening
        await this.openModal(productUrl, button);
      },

      async openModal(productUrl, button) {
        const dialogComponent = document.getElementById('quick-add-dialog');
        if (!dialogComponent) {
          console.error('FCH Quick Add: Dialog not found');
          window.location.href = productUrl;
          return;
        }

        try {
          if (button) {
            button.disabled = true;
            button.style.opacity = '0.6';
          }

          const response = await fetch(productUrl);
          if (!response.ok) throw new Error('Fetch failed: ' + response.status);

          const html = await response.text();
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');

          const productGrid = doc.querySelector('[data-product-grid-content]');
          const modalContent = document.getElementById('quick-add-modal-content');

          if (productGrid && modalContent) {
            modalContent.innerHTML = '';
            const clone = productGrid.cloneNode(true);
            modalContent.appendChild(clone);
            this.initializeClonedElements(modalContent);

            const dialogEl = dialogComponent.querySelector('dialog');
            if (dialogEl) {
              if (typeof dialogEl.showModal === 'function') {
                dialogEl.showModal();
              } else {
                dialogEl.setAttribute('open', '');
              }
            }
          } else {
            console.error('FCH Quick Add: Product grid not found');
            window.location.href = productUrl;
          }
        } catch (error) {
          console.error('FCH Quick Add error:', error);
          window.location.href = productUrl;
        } finally {
          if (button) {
            button.disabled = false;
            button.style.opacity = '';
          }
        }
      },

      initializeClonedElements(container) {
        const customElements = container.querySelectorAll('product-form-component, variant-picker, product-price');
        customElements.forEach(el => {
          const parent = el.parentNode;
          const next = el.nextSibling;
          parent.removeChild(el);
          parent.insertBefore(el, next);
        });
      }
    };

    function setupSwipeToClose() {
      const dialogComponent = document.getElementById('quick-add-dialog');
      if (!dialogComponent) return;

      const dialog = dialogComponent.querySelector('dialog');
      if (!dialog) return;

      let startY = 0;
      let currentY = 0;
      let isDragging = false;

      dialog.addEventListener('touchstart', (e) => {
        const touch = e.touches[0];
        const rect = dialog.getBoundingClientRect();
        if (touch.clientY - rect.top > 60) return;

        startY = touch.clientY;
        currentY = startY;
        isDragging = true;
        dialog.style.transition = 'none';
      }, { passive: true });

      dialog.addEventListener('touchmove', (e) => {
        if (!isDragging) return;

        currentY = e.touches[0].clientY;
        const deltaY = currentY - startY;

        if (deltaY > 0) {
          dialog.style.transform = `translateY(${deltaY}px)`;
        }
      }, { passive: true });

      dialog.addEventListener('touchend', () => {
        if (!isDragging) return;

        isDragging = false;
        const deltaY = currentY - startY;

        dialog.style.transition = 'transform 0.3s cubic-bezier(0.4, 0, 0.2, 1)';

        if (deltaY > 80) {
          dialog.style.transform = 'translateY(100%)';
          setTimeout(() => {
            if (typeof dialog.close === 'function') {
              dialog.close();
            } else {
              dialog.removeAttribute('open');
            }
            dialog.style.transform = '';
            dialog.style.transition = '';
          }, 300);
        } else {
          dialog.style.transform = '';
        }

        startY = 0;
        currentY = 0;
      }, { passive: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
{% endjavascript %}


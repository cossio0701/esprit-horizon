{%- comment -%}
  Product Breadcrumb Section - OS 2.0 Compatible

  Características:
  - Detección inteligente de colección de origen
  - Compatible con Customizer
  - Comportamiento especial para /cart
  - Sin dependencias externas
{%- endcomment -%}

{%- liquid
  # Generar ID único para estilos scoped
  assign section_id = section.id | replace: '_', '' | downcase

  # ============================================
  # DETECCIÓN INTELIGENTE DE COLECCIÓN
  # ============================================
  assign breadcrumb_collection = null
  assign breadcrumb_collection_title = ''
  assign breadcrumb_collection_url = ''
  assign collection_source = 'none'

  # 1. Verificar parámetro URL ?collection=handle
  if request.path contains '/products/'
    assign url_collection_handle = request.query_string | split: 'collection=' | last | split: '&' | first
    if url_collection_handle != blank and url_collection_handle != request.query_string
      assign breadcrumb_collection = collections[url_collection_handle]
      if breadcrumb_collection != blank
        assign breadcrumb_collection_title = breadcrumb_collection.title
        assign breadcrumb_collection_url = breadcrumb_collection.url
        assign collection_source = 'url_param'
      endif
    endif
  endif

  # 2. Verificar URL canónica /collections/X/products/Y
  if breadcrumb_collection == blank and request.path contains '/collections/'
    assign path_parts = request.path | split: '/'
    for part in path_parts
      if forloop.index > 1
        assign prev_index = forloop.index | minus: 2
        assign prev_part = path_parts[prev_index]
        if prev_part == 'collections' and part != 'products'
          assign canonical_collection = collections[part]
          if canonical_collection != blank
            assign breadcrumb_collection = canonical_collection
            assign breadcrumb_collection_title = canonical_collection.title
            assign breadcrumb_collection_url = canonical_collection.url
            assign collection_source = 'canonical_url'
            break
          endif
        endif
      endif
    endfor
  endif

  # 3. Verificar variable collection global
  if breadcrumb_collection == blank and collection != blank
    assign breadcrumb_collection = collection
    assign breadcrumb_collection_title = collection.title
    assign breadcrumb_collection_url = collection.url
    assign collection_source = 'global_var'
  endif

  # 4. Usar primera colección del producto
  if breadcrumb_collection == blank and product != blank and product.collections.size > 0
    assign breadcrumb_collection = product.collections.first
    assign breadcrumb_collection_title = product.collections.first.title
    assign breadcrumb_collection_url = product.collections.first.url
    assign collection_source = 'product_first'
  endif

  # ============================================
  # DETERMINAR ELEMENTO FINAL DEL BREADCRUMB
  # ============================================
  assign final_item_title = ''
  assign final_item_url = ''
  assign final_item_type = 'none'

  if product != blank
    assign final_item_type = 'product'
    assign final_item_title = product.title
    assign final_item_url = product.url
  elsif collection != blank
    assign final_item_type = 'collection'
    assign final_item_title = collection.title
    assign final_item_url = collection.url
  elsif page != blank
    assign final_item_type = 'page'
    assign final_item_title = page.title
    assign final_item_url = page.url
  elsif search != blank
    assign final_item_type = 'search'
    assign final_item_title = search.terms
    assign final_item_url = routes.search_url | append: '?q=' | append: search.terms
  endif

  # Configurar separador
  case section.settings.separator_style
    when 'slash'
      assign separator = '/'
    when 'arrow'
      assign separator = '→'
    when 'chevron'
      assign separator = '›'
    when 'pipe'
      assign separator = '|'
    else
      assign separator = '/'
  endcase
-%}

{%- style -%}
  .product-breadcrumb-section-{{ section_id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }

  .product-breadcrumb__wrapper-{{ section_id }} {
    padding: 0;
  }

  .product-breadcrumb__list-{{ section_id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: {{ section.settings.item_spacing }}px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: {{ section.settings.font_size }}px;
    line-height: 1.4;
  }

  .product-breadcrumb__item-{{ section_id }} {
    display: flex;
    align-items: center;
    gap: {{ section.settings.item_spacing }}px;
  }

  .product-breadcrumb__link-{{ section_id }} {
    color: {{ section.settings.link_color }};
    text-decoration: {% if section.settings.link_underline %}underline{% else %}none{% endif %};
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .product-breadcrumb__link-{{ section_id }}:hover,
  .product-breadcrumb__link-{{ section_id }}:focus {
    color: {{ section.settings.link_hover_color }};
    opacity: 0.8;
  }

  .product-breadcrumb__separator-{{ section_id }} {
    color: {{ section.settings.separator_color }};
    font-size: {{ section.settings.font_size }}px;
    user-select: none;
  }

  .product-breadcrumb__current-{{ section_id }} {
    color: {{ section.settings.current_color }};
    font-weight: 600;
  }

  {%- if section.settings.show_home_icon -%}
  .product-breadcrumb__home-icon-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    width: {{ section.settings.font_size | plus: 2 }}px;
    height: {{ section.settings.font_size | plus: 2 }}px;
  }

  .product-breadcrumb__home-icon-{{ section_id }} svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
  {%- endif -%}

  /* Estilos para link del carrito */
  .product-breadcrumb__cart-link-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: {{ section.settings.link_color }};
    font-size: {{ section.settings.font_size }}px;
    font-weight:500;
    border-bottom: 1px solid #000;
    padding-bottom: 2px;
    transition: color 0.3s ease;
  }

  .product-breadcrumb__cart-link-{{ section_id }}:hover {
    color: {{ section.settings.link_hover_color }};
  }

  .product-breadcrumb__cart-link-{{ section_id }} svg {
    transition: transform 0.3s ease;
  }

  .product-breadcrumb__cart-link-{{ section_id }}:hover svg {
    transform: translateX(-4px);
  }

  @media screen and (max-width: 749px) {
    .product-breadcrumb__cart-link-{{ section_id }} {
      font-size: {{ section.settings.font_size_mobile }}px;
    }

    .product-breadcrumb-section-{{ section_id }} {
      padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    }

    .product-breadcrumb__list-{{ section_id }} {
      font-size: {{ section.settings.font_size_mobile }}px;
      gap: {{ section.settings.item_spacing_mobile }}px;
    }

    .product-breadcrumb__item-{{ section_id }} {
      gap: {{ section.settings.item_spacing_mobile }}px;
    }

    .product-breadcrumb__separator-{{ section_id }} {
      font-size: {{ section.settings.font_size_mobile }}px;
    }
  }
{%- endstyle -%}
<nav
  class="section section--page-width product-breadcrumb-section-{{ section_id }}{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}"
  aria-label="{{ section.settings.aria_label | default: 'Breadcrumb' }}"
  data-collection-source="{{ collection_source }}"
>
  <pre style="background:#f5f5f5;padding:12px;border:1px solid #ddd;">
  request.path: {{ request.path }}
  request.query_string: {{ request.query_string }}
  template: {{ template }}
  </pre>

  <div class="product-breadcrumb__wrapper-{{ section_id }}">
    {%- if request.path == '/cart' -%}
      <a href="{{ routes.all_products_collection_url }}" class="product-breadcrumb__cart-link-{{ section_id }}">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path d="M19 12H5M5 12L12 19M5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>{{ section.settings.home_text }}</span>
      </a>
    {%- else -%}
      <ol class="product-breadcrumb__list-{{ section_id }}" itemscope itemtype="https://schema.org/BreadcrumbList">
        {%- comment -%} Home {%- endcomment -%}
        <li
          class="product-breadcrumb__item-{{ section_id }}"
          itemprop="itemListElement"
          itemscope
          itemtype="https://schema.org/ListItem"
        >
          <a
            href="{{ routes.root_url }}"
            class="product-breadcrumb__link-{{ section_id }}"
            itemprop="item"
          >
            {%- if section.settings.show_home_icon -%}
              <span class="product-breadcrumb__home-icon-{{ section_id }}" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                </svg>
              </span>
              <span class="visually-hidden">{{ section.settings.home_text }}</span>
            {%- else -%}
              <span itemprop="name">{{ section.settings.home_text }}</span>
            {%- endif -%}
          </a>
          <meta itemprop="position" content="1">
        </li>

        {%- comment -%} Collection (si existe) {%- endcomment -%}
        {%- if breadcrumb_collection != blank -%}
          <li class="product-breadcrumb__item-{{ section_id }}" aria-hidden="true">
            <span class="product-breadcrumb__separator-{{ section_id }}">{{ separator }}</span>
          </li>
          <li
            class="product-breadcrumb__item-{{ section_id }}"
            itemprop="itemListElement"
            itemscope
            itemtype="https://schema.org/ListItem"
          >
            {%- if final_item_type == 'product' or final_item_type == 'page' -%}
              <a
                href="{{ breadcrumb_collection_url }}"
                class="product-breadcrumb__link-{{ section_id }}"
                itemprop="item"
              >
                <span itemprop="name">{{ breadcrumb_collection_title }}</span>
              </a>
            {%- else -%}
              <span class="product-breadcrumb__current-{{ section_id }}" itemprop="name">
                {{ breadcrumb_collection_title }}
              </span>
            {%- endif -%}
            <meta itemprop="position" content="2">
          </li>
        {%- endif -%}

        {%- comment -%} Elemento final (Producto/Página/Búsqueda) {%- endcomment -%}
        {%- if final_item_title != blank and final_item_type != 'collection' -%}
          <li class="product-breadcrumb__item-{{ section_id }}" aria-hidden="true">
            <span class="product-breadcrumb__separator-{{ section_id }}">{{ separator }}</span>
          </li>
          <li
            class="product-breadcrumb__item-{{ section_id }}"
            itemprop="itemListElement"
            itemscope
            itemtype="https://schema.org/ListItem"
          >
            <span
              class="product-breadcrumb__current-{{ section_id }}"
              itemprop="name"
              aria-current="page"
            >
              {{ final_item_title }}
            </span>
            <link itemprop="item" href="{{ shop.url }}{{ final_item_url }}">
            <meta itemprop="position" content="{% if breadcrumb_collection != blank %}3{% else %}2{% endif %}">
          </li>
        {%- endif -%}
      </ol>
    {%- endif -%}
  </div>
</nav>

{% schema %}
{
  "name": "Breadcrumb de Producto",
  "tag": "section",
  "class": "product-breadcrumb-section",
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "home_text",
      "label": "Texto de inicio",
      "default": "Inicio"
    },
    {
      "type": "checkbox",
      "id": "show_home_icon",
      "label": "Mostrar icono de inicio",
      "default": false,
      "info": "Reemplaza el texto por un icono de casa"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Etiqueta de accesibilidad",
      "default": "Navegación de migas de pan"
    },
    {
      "type": "header",
      "content": "Separador"
    },
    {
      "type": "select",
      "id": "separator_style",
      "label": "Estilo de separador",
      "options": [
        { "value": "slash", "label": "Barra (/)" },
        { "value": "arrow", "label": "Flecha (→)" },
        { "value": "chevron", "label": "Chevron (›)" },
        { "value": "pipe", "label": "Barra vertical (|)" }
      ],
      "default": "slash"
    },
    {
      "type": "header",
      "content": "Tipografía"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Tamaño de fuente",
      "default": 14
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Tamaño de fuente móvil",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Color de enlaces",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Color de enlaces (hover)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Color del separador",
      "default": "#999999"
    },
    {
      "type": "color",
      "id": "current_color",
      "label": "Color elemento actual",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "link_underline",
      "label": "Subrayar enlaces",
      "default": false
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "item_spacing",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Espacio entre elementos",
      "default": 8
    },
    {
      "type": "range",
      "id": "item_spacing_mobile",
      "min": 4,
      "max": 16,
      "step": 2,
      "unit": "px",
      "label": "Espacio entre elementos (móvil)",
      "default": 6
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding superior",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding superior (móvil)",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior (móvil)",
      "default": 12
    },
    {
      "type": "header",
      "content": "Avanzado"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class",
      "info": "Agrega clases CSS personalizadas al elemento"
    }
  ],
  "presets": [
    {
      "name": "Breadcrumb de Producto",
      "category": "Navegación"
    }
  ]
}
{% endschema %}

{% comment %}
  Sección: Carrusel de Colección
  Renderiza un carrusel basado en el metafield custom.collection_carousel
  que contiene un metaobjeto "media" con: key, title, file, link
{% endcomment %}

{%- comment -%}
  ============================================
    SECCIÓN 1: LÓGICA Y ASIGNACIÓN DE VARIABLES (FACHADA)
  ============================================
{%- endcomment -%}

{%- liquid
  # Obtener la colección desde el contexto de la página
  assign current_collection = collection

  # Obtener el metafield del carrusel
  assign carousel_metafield = current_collection.metafields.custom.collection_carousel

  # Verificar si el metafield existe y tiene valores
  assign has_carousel_items = false
  if carousel_metafield != blank and carousel_metafield.value != blank
    assign has_carousel_items = true
    assign carousel_items = carousel_metafield.value
  endif

  # Configuraciones de la sección
  assign section_width = section.settings.section_width
  assign show_arrows = section.settings.show_arrows
  assign show_dots = section.settings.show_dots
  assign arrows_color = section.settings.arrows_color
  assign dots_color = section.settings.dots_color
  assign dots_active_color = section.settings.dots_active_color
  assign slides_per_view_mobile = section.settings.slides_per_view_mobile
  assign slides_per_view_desktop = section.settings.slides_per_view_desktop
  assign space_between = section.settings.space_between
  assign loop_enabled = section.settings.loop_enabled
  assign autoplay_enabled = section.settings.autoplay_enabled
  assign autoplay_delay = section.settings.autoplay_delay
-%}

{%- comment -%}
  ============================================
    SECCIÓN 2: ESTRUCTURA HTML
  ============================================
{%- endcomment -%}

{% if has_carousel_items %}
  <section class="collection-carousel-section section section--{{ section_width }}">
    <script src="{{ 'carousel-component.js' | asset_url }}" type="module"></script>
    <carousel-component
      class="collection-carousel-swiper"
      columns-desktop="{{ slides_per_view_desktop }}"
      columns-mobile="{{ slides_per_view_mobile }}"
      gap="{{ space_between }}"
      show-arrows="{{ show_arrows }}"
      show-dots="{{ show_dots }}"
      loop="{{ loop_enabled }}"
      autoplay="{{ autoplay_enabled }}"
      autoplay-speed="{{ autoplay_delay }}"
      style="
        --slides-per-view-desktop: {{ slides_per_view_desktop }};
        --slides-per-view-mobile: {{ slides_per_view_mobile }};
        --carousel-gap: {{ space_between }}px;
      "
    >
      <div class="carousel-scroller-wrapper">
        <div role="list" class="carousel-scroller">
          {% for item in carousel_items %}
            {%- liquid
              assign item_title = item.title
              assign item_file = item.file
              assign item_link = item.link.url
            -%}

            <div role="listitem" class="carousel-slide collection-carousel-slide">
              {% if item_link != blank %}
                <a href="{{ item_link }}" class="carousel-item-link">
              {% endif %}

              {% if item_file != blank %}
                <div class="carousel-item-image">
                  {{ item_file | image_url: width: 800 | image_tag: loading: 'lazy', class: 'carousel-image' }}
                </div>
              {% endif %}

              {% if item_title != blank %}
                <div class="carousel-item-title">
                  {{ item.title | metafield_tag }}
                </div>
              {% endif %}

              {% if item_link != blank %}
                </a>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        {% if show_arrows %}
          <button
            type="button"
            name="previous"
            class="carousel-button prev"
            aria-label="{{ 'accessibility.slideshow_previous' | t }}"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button
            type="button"
            name="next"
            class="carousel-button next"
            aria-label="{{ 'accessibility.slideshow_next' | t }}"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="9 6 15 12 9 18"></polyline>
            </svg>
          </button>
        {% endif %}
      </div>
    </carousel-component>
  </section>
{% endif %}

<style>
  .collection-carousel-section {
    width: 100%;
    padding: 2rem 0 1rem;
  }

  .collection-carousel-swiper {
    position: relative;
    width: 100%;
  }

  .collection-carousel-slide {
    height: auto;
    display: flex;
    flex-direction: column;
    background: transparent;
  }

  .carousel-item-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
    flex: 1;
  }

  .carousel-item-link:hover {
    transform: translateY(-4px);
  }

  .carousel-item-image {
    width: 100%;
    overflow: hidden;
    border-radius: 0;
    margin-bottom: 1rem;
    background: transparent;
  }

  .carousel-image {
    min-width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .carousel-item-link:hover .carousel-image {
    transform: scale(1.05);
  }

  .carousel-item-title {
    width: 100%;
    text-align: left;
    font-size: 1rem;
    line-height: 1.4;
    color: #333;
    background: transparent;
  }

  .carousel-item-title p {
    margin: 0;
    background: transparent;
  }

  /* Carousel component overrides */
  .collection-carousel-swiper[has-arrows] .carousel-button {
    color: {{ arrows_color }};
    background: white; /* Match Swiper's logic or preferences */
    opacity: 0.7;
    transition: opacity 0.2s;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  }

  .collection-carousel-swiper[has-arrows] .carousel-button:hover {
    opacity: 1;
  }

  .collection-carousel-swiper .carousel-dots button {
    background: transparent;
    border-color: {{ dots_color }};
    opacity: 0.5;
    width: 10px;
    height: 10px;
    transition: opacity 0.3s, background 0.3s, transform 0.3s;
  }

  .collection-carousel-swiper .carousel-dots button[aria-selected="true"] {
    background: {{ dots_active_color }};
    border-color: {{ dots_active_color }};
    opacity: 1;
    transform: scale(1.2);
  }

  @media (max-width: 767px) {
    .carousel-item-title {
      font-size: 0.875rem;
    }
  }
</style>

{% schema %}
{
  "name": "Carrusel de Colección",
  "tag": "section",
  "class": "section-collection-carousel",
  "settings": [
    {
      "type": "header",
      "content": "Configuración del Carrusel"
    },
    {
      "type": "range",
      "id": "slides_per_view_mobile",
      "min": 1,
      "max": 3,
      "step": 0.5,
      "label": "Slides visibles (móvil)",
      "default": 1.5
    },
    {
      "type": "range",
      "id": "slides_per_view_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Slides visibles (escritorio)",
      "default": 4
    },
    {
      "type": "range",
      "id": "space_between",
      "min": 0,
      "max": 50,
      "step": 5,
      "label": "Espacio entre slides (px)",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "loop_enabled",
      "label": "Loop infinito",
      "info": "El carrusel volverá al inicio automáticamente al llegar al final",
      "default": false
    },
    {
      "type": "header",
      "content": "Navegación"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Mostrar flechas",
      "default": true
    },
    {
      "type": "color",
      "id": "arrows_color",
      "label": "Color de flechas",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Mostrar paginación",
      "default": true
    },
    {
      "type": "color",
      "id": "dots_color",
      "label": "Color dots (inactivos)",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "dots_active_color",
      "label": "Color dot activo",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay_enabled",
      "label": "Activar autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 2000,
      "max": 9000,
      "step": 1000,
      "label": "Delay autoplay (ms)",
      "default": 5000
    },
    {
      "type": "header",
      "content": "Diseño de la Sección"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho",
      "options": [
        {
          "value": "page-width",
          "label": "Ancho de página"
        },
        {
          "value": "full-width",
          "label": "Ancho completo"
        }
      ],
      "default": "page-width"
    }
  ],
  "presets": [
    {
      "name": "Carrusel de Colección"
    }
  ]
}
{% endschema %}

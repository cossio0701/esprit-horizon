{% comment %}
  Archivo: sections/tabbed-sidebar-menu.liquid
  Descripción: Sección contenedora que orquesta el layout de sidebar y tabs.
{% endcomment %}

{%- style -%}
  /* --- CSS Scoped para esta sección --- */
    /* max-width and margin are now handled by the .section wrapper */
    /* padding is handled by style attribute from settings */

  #shopify-section-{{ section.id }} .sidebar-tabs-layout {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .sidebar-tabs-layout {
      flex-direction: row;
      align-items: flex-start; /* Importante para que el sidebar no se estire */
      gap: 30px;
    }
  }

  /* --- Estilos del Sidebar --- */
  #shopify-section-{{ section.id }} .sidebar-tabs-sidebar {
    display: flex;
    flex-direction: column;
    width: 100%;
    background-color: #f8f9fa;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #e9ecef;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .sidebar-tabs-sidebar {
        width: 25%;
        position: sticky; /* Hace que el sidebar se quede fijo al hacer scroll */
        top: 20px;
    }
  }

  /* Botones generados por JS */
  #shopify-section-{{ section.id }} .tab-sidebar__button {
    appearance: none;
    background: transparent;
    border: none;
    border-bottom: 1px solid #e9ecef;
    padding: 15px 20px;
    text-align: left;
    font-size: 16px;
    font-weight: 500;
    color: #495057;
    cursor: pointer;
    transition: all 0.2s ease;
    width: 100%;
    outline: none;
  }

  #shopify-section-{{ section.id }} .tab-sidebar__button:hover {
    background-color: #e9ecef;
    color: #212529;
  }

  #shopify-section-{{ section.id }} .tab-sidebar__button.active {
    background-color: #ffffff;
    color: #000000;
    font-weight: 700;
    border-left: 4px solid #000000; /* Acento visual */
    padding-left: 16px; /* Ajuste por el borde */
  }


  /* --- Estilos del Área Principal --- */
  #shopify-section-{{ section.id }} .sidebar-tabs-main {
    flex: 1;
    background: #ffffff;
    /* Min height para que no colapse si está vacío */
    min-height: 300px;
  }

  /* Estilos para los paneles de contenido */
  .tab-content__pane {
    animation: fadeIn 0.3s ease-in-out;
  }

  /* Un poco de espaciado interno para los bloques anidados */
  .tab-content__inner-wrapper {
      padding: 20px;
      border: 1px solid #e9ecef;
      border-radius: 8px;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Estado de carga inicial para evitar FOUC (Flash of Unstyled Content) */
  .sidebar-tabs-layout.loading .sidebar-tabs-sidebar,
  .sidebar-tabs-layout.loading .sidebar-tabs-main {
    opacity: 0;
    visibility: hidden;
  }
{%- endstyle -%}

<div class="section-background color-scheme-1"></div>
<div
  class="section spacing-style section--{{ section.settings.section_width }} sidebar-tabs-layout js-tabs-container"
  data-section-id="{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <aside class="sidebar-tabs-sidebar" role="tablist"></aside>

  <main class="sidebar-tabs-main">
    {%- comment -%}
      Aquí Shopify renderiza los archivos blocks/tab.liquid.
      Aunque se renderizan, sus contenidos están ocultos por CSS inicialmente,
      y sus botones están dentro de etiquetas <template>.
    {%- endcomment -%}
    {% content_for 'blocks' %}
  </main>
</div>

<script>
  (function () {
    const initTabs = () => {
      const sectionId = '{{ section.id }}';
      const container = document.querySelector(`.js-tabs-container[data-section-id="${sectionId}"]`);
      if (!container) return;

      const sidebarTarget = container.querySelector('.sidebar-tabs-sidebar');
      // CORRECCIÓN: Buscamos el template directamente en el bloque, no dentro del pane
      const portals = container.querySelectorAll('.js-tab-portal-source');

      // Limpiamos el sidebar por si acaso (evita duplicados en el editor)
      sidebarTarget.innerHTML = '';

      if (portals.length === 0) {
        container.classList.remove('loading');
        return;
      }

      function activateTab(buttonElement) {
        sidebarTarget.querySelectorAll('.tab-sidebar__button').forEach((btn) => {
          btn.classList.remove('active');
          btn.setAttribute('aria-selected', 'false');
        });

        container.querySelectorAll('.tab-content__pane').forEach((pane) => {
          pane.style.display = 'none';
        });

        buttonElement.classList.add('active');
        buttonElement.setAttribute('aria-selected', 'true');

        const targetId = buttonElement.dataset.targetId;
        const targetPane = document.getElementById(targetId);
        if (targetPane) {
          targetPane.style.display = 'block';
        }
      }

      portals.forEach((portal, index) => {
        // Accedemos al contenido del template
        const button = portal.content.querySelector('.tab-sidebar__button').cloneNode(true);

        button.addEventListener('click', function () {
          activateTab(this);
        });

        sidebarTarget.appendChild(button);

        if (index === 0) {
          activateTab(button);
        }
      });

      container.classList.remove('loading');
    };

    // Ejecutar al cargar el DOM
    document.addEventListener('DOMContentLoaded', initTabs);

    // Ejecutar específicamente para el Editor de Shopify (cuando se re-renderiza la sección)
    document.addEventListener('shopify:section:load', initTabs);

    // Ejecución inmediata por si el DOM ya está listo
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initTabs();
    }
  })();
</script>

{% schema %}
{
  "name": "Menú Lateral Anidado",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "tab"
    }
  ],
  "presets": [
    {
      "name": "Menú Lateral Anidado",
      "blocks": [
        { "type": "tab", "settings": { "title": "Introducción" } },
        { "type": "tab", "settings": { "title": "Características" } },
        { "type": "tab", "settings": { "title": "Contacto" } }
      ]
    }
  ]
}
{% endschema %}

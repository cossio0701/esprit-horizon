{% liquid
  if product == blank
    assign product = closest.product
  endif

  assign current_variant = product.selected_or_first_available_variant

  assign color_option_index = null
  for option in product.options_with_values
    assign option_name_lower = option.name | downcase
    assign swatch_count = option.values | map: 'swatch' | compact | size
    if option_name_lower == 'color' or swatch_count > 0
      assign color_option_index = forloop.index0
      break
    endif
  endfor

  if color_option_index == 0
    assign current_color = current_variant.option1
  elsif color_option_index == 1
    assign current_color = current_variant.option2
  elsif color_option_index == 2
    assign current_color = current_variant.option3
  else
    assign current_color = current_variant.option1
  endif
%}

<div class="quick-add-content" data-product-id="{{ product.id }}">
  <div class="quick-add-content__media">
    <carousel-component
      columns-desktop="2.5"
      columns-mobile="2.25"
      gap="1"
      show-arrows="false"
      show-dots="false"
      thumbs-mobile="none"
      thumbs-desktop="none"
      loop="true"
    >
      <div class="carousel-scroller-wrapper">
        <div role="list" class="carousel-scroller">
          {% liquid
            assign color_gallery = null
            for variant in product.variants
              if color_option_index == 1
                assign variant_color = variant.option2
              elsif color_option_index == 2
                assign variant_color = variant.option3
              else
                assign variant_color = variant.option1
              endif

              if variant_color == current_color and variant.metafields.custom.gallery.value != blank
                assign color_gallery = variant.metafields.custom.gallery.value
                break
              endif
            endfor
          %}

          {% if color_gallery %}
            {% for image in color_gallery %}
              <div role="listitem" class="carousel-slide">
                {{
                  image
                  | image_url: width: 800
                  | image_tag: loading: 'lazy', alt: product.title, widths: '400, 600, 800'
                }}
              </div>
            {% endfor %}
          {% else %}
            {% for media in product.media %}
              {% if media.media_type == 'image' %}
                <div role="listitem" class="carousel-slide">
                  {{
                    media
                    | image_url: width: 800
                    | image_tag: loading: 'lazy', alt: product.title, widths: '400, 600, 800'
                  }}
                </div>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>

        <button
          type="button"
          name="previous"
          class="carousel-button prev"
          aria-label="{{ 'accessibility.slideshow_previous' | t }}"
        >
          {{- 'icon-chevron-left.svg' | inline_asset_content -}}
        </button>
        <button
          type="button"
          name="next"
          class="carousel-button next"
          aria-label="{{ 'accessibility.slideshow_next' | t }}"
        >
          {{- 'icon-chevron-right.svg' | inline_asset_content -}}
        </button>
      </div>
    </carousel-component>
  </div>

  <div class="quick-add-content__info">
    <a href="{{ product.url }}" class="quick-add-content__title">
      {{ product.title }}
    </a>

    {% if product.metafields.custom.color_group != blank %}
      <span class="quick-add-content__reference">
        Ref: {{ product.metafields.custom.color_group }}
      </span>
    {% endif %}

    <product-price>
      {% render 'price', product_resource: product, show_unit_price: true %}
    </product-price>

    <hr class="quick-add-content__divider">

    {% unless product.has_only_default_variant %}
      <script src="{{ 'variant-picker.js' | asset_url }}" type="module"></script>
      {%- content_for 'block', type: 'variant-picker', id: 'quick-add-variant-picker', closest.product: product -%}
    {% endunless %}

    {% if product.metafields.custom.model_fit != blank %}
      <div class="quick-add-content__model-fit">
        <span>{{ product.metafields.custom.model_fit }}</span>
      </div>
    {% endif %}

    <script src="{{ 'product-form.js' | asset_url }}" type="module"></script>
    {%- content_for 'block', type: 'buy-buttons', id: 'quick-add-buy-buttons', closest.product: product -%}

    <a href="{{ product.url }}" class="quick-add-content__view-details">
      {{ 'products.product.view_full_details' | t }}
    </a>
  </div>
</div>

{% stylesheet %}
  .quick-add-content {
    display: flex;
    flex-direction: column;
    background: var(--color-background);
  }

  .quick-add-content__media {
    width: 100%;
    position: relative;
    background: var(--color-surface, rgb(var(--color-foreground-rgb) / 0.05));
  }

  .quick-add-content__media carousel-component {
    display: block;
    width: 100%;
  }

  .quick-add-content__info {
    padding: var(--padding-lg);
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
  }

  .quick-add-content__title {
    color: inherit;
    text-decoration: none;
    font-size: var(--font-size-md, 16px);
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: none;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .quick-add-content__title:hover {
    text-decoration: underline;
  }

  .quick-add-content__reference {
    display: block;
    font-size: var(--font-size-xs, 12px);
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.5));
    font-weight: 400;
    margin-block-start: -4px;
  }

  .quick-add-content__info product-price .price {
    font-size: var(--font-size-md, 16px);
    font-weight: 700;
  }

  .quick-add-content__info product-price .compare-at-price {
    font-size: var(--font-size-sm, 14px);
    opacity: 0.6;
    text-decoration: line-through;
  }

  .quick-add-content__divider {
    border: none;
    border-block-start: 1px solid var(--color-border, rgb(var(--color-foreground-rgb) / 0.1));
    margin-block: var(--margin-xs);
  }

  .quick-add-content .variant-picker__form {
    display: flex;
    flex-direction: column;
  }

  .quick-add-content .variant-option--swatches {
    order: -1;
  }

  .quick-add-content .variant-option legend {
    font-weight: 700;
  }

  .quick-add-content__model-fit {
    font-size: var(--font-size-sm, 13px);
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.7));
    line-height: 1.4;
  }

  .quick-add-content__view-details {
    display: block;
    text-align: center;
    font-size: var(--font-size-sm, 13px);
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / 0.7));
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
    width: 100%;
    margin-block-start: var(--margin-md);
    padding-block-end: var(--padding-lg);
  }

  .quick-add-content__view-details:hover {
    color: var(--color-foreground);
  }

  .quick-add-content__info .buy-buttons-block {
    width: 100%;
  }

  .quick-add-content__info .quantity-selector {
    display: none;
  }

  .quick-add-content__info .accelerated-checkout-block {
    display: none;
  }

  .quick-add-content__info .product-form-buttons {
    display: flex;
    width: 100%;
  }

  .quick-add-content__info .product-form-buttons > span:not(.accelerated-checkout-block) {
    flex: 1;
    width: 100%;
  }

  .quick-add-content__info .product-form-buttons button {
    width: 100%;
    min-width: 100%;
  }

  .quick-add-content__info .add-to-cart-button {
    background-color: #000;
    color: #fff;
    border: 1px solid #000;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
  }

  .quick-add-content__info .add-to-cart-button:hover {
    background-color: #222;
    border-color: #222;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Quick Add Content",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    }
  ]
}
{% endschema %}

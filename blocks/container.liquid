{%- comment -%}
  SECCIÓN 1: LÓGICA Y ASIGNACIÓN DE VARIABLES (Facade Pattern)
{%- endcomment -%}

{%- liquid
  # Capturar los bloques hijos
  capture children
    content_for 'blocks'
  endcapture

  # Importa snippet CSS custom
  capture styles
    render 'theme-editor-styles', block: block
  endcapture

  # Tag personalizado (opcional)
  assign tag = block.settings.html_tag | default: 'div'

  # Obtener la clase CSS personalizada del schema
  assign container_class = block.settings.container_class

  # Verificar si hay contenido para renderizar
  assign has_content = false
  assign trimmed_children = children | strip
  if trimmed_children != blank
    assign has_content = true
  endif
-%}

{%- comment -%}
  SECCIÓN 2: HTML/ESTRUCTURA
{%- endcomment -%}

{%- liquid
  assign container_styles = styles | append: '; display: flex;'
-%}

{% if has_content %}
  <style>
    [data-block-id="{{ block.id }}"] {
      flex-direction: var(--direction-mobile);
    }
    @media screen and (min-width: 750px) {
      [data-block-id="{{ block.id }}"] {
        flex-direction: var(--direction-desktop);
      }
    }
  </style>

  {% if block.settings.enable_section_width %}
    <div
      class="section section--{{ block.settings.section_width }}"
      {{ block.shopify_attributes }}
    >
      <{{ tag }}
        class="gco-container {{ container_class }}"
        data-block-id="{{ block.id }}"
        style="{{ container_styles }}"
      >
        {{ children }}
      </{{ tag }}>
    </div>
  {% else %}
    <{{ tag }}
      class="gco-container {{ container_class }}"
      data-block-id="{{ block.id }}"
      style="{{ container_styles }}"
      {{ block.shopify_attributes }}
    >
      {{ children }}
    </{{ tag }}>
  {% endif %}
{% endif %}

{%- comment -%}
  SECCIÓN 3: SCHEMA
{%- endcomment -%}

{% schema %}
{
  "name": "Container",
  "tag": null,
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" },
    { "type": "_localization" },
    { "type": "_customer_account" },
    { "type": "_cart" },
    { "type": "_search" },
    { "type": "_modal-trigger" }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "Este bloque actúa como contenedor principal, anidando otros bloques para crear estructuras personalizadas."
    },
    {
      "type": "header",
      "content": "SEO"
    },
    {
      "type": "select",
      "id": "html_tag",
      "label": "Etiqueta HTML",
      "options": [
        { "value": "div", "label": "div" },
        { "value": "section", "label": "section" },
        { "value": "article", "label": "article" },
        { "value": "main", "label": "main" }
      ],
      "default": "div"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "checkbox",
      "id": "enable_section_width",
      "label": "Habilitar ancho de sección",
      "default": false
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width",
      "visible_if": "{{ block.settings.enable_section_width == true }}"
    },
    {
      "type": "select",
      "id": "desktop_direction",
      "label": "Dirección escritorio",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "row"
    },
    {
      "type": "select",
      "id": "mobile_direction",
      "label": "Dirección móvil",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "row"
    },
    {
      "type": "select",
      "id": "gap_unit",
      "label": "Unidad de espacio (Gap)",
      "options": [
        { "value": "px", "label": "px" },
        { "value": "responsive", "label": "responsive (clamp)" }
      ],
      "default": "px"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Espaciado entre elementos (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Espaciado entre elementos (Móvil)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ block.settings.gap_unit == 'responsive' }}"
    },
    {
      "type": "header",
      "content": "Apariencia"
    },
    {
      "type": "select",
      "id": "border",
      "label": "Bordes",
      "options": [
        {
          "value": "none",
          "label": "Ninguno"
        },
        {
          "value": "solid",
          "label": "Color sólido"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 0.2,
      "unit": "px",
      "label": "Ancho del borde",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Radio del borde",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color del borde",
      "alpha": true,
      "default": "#000000",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "header",
      "content": "Espaciado interno"
    },
    {
      "type": "select",
      "id": "padding_unit",
      "label": "Unidad de relleno (Padding)",
      "options": [
        { "value": "px", "label": "px" },
        { "value": "responsive", "label": "responsive (clamp)" }
      ],
      "default": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Arriba (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Arriba (Móvil)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_unit == 'responsive' }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abajo (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Abajo (Móvil)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_unit == 'responsive' }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Izquierda (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Izquierda (Móvil)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_unit == 'responsive' }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Derecha (Desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "Derecha (Móvil)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.padding_unit == 'responsive' }}"
    },
    {
      "type": "header",
      "content": "Personalización"
    },
    {
      "type": "text",
      "id": "container_class",
      "label": "Clases CSS del contenedor",
      "default": "container",
      "info": "Puedes usar múltiples clases separadas por espacios (ej: 'container mx-auto px-4')."
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "CSS personalizado",
      "info": "Líneas de CSS directo al contenedor."
    }
  ],
  "presets": [
    {
      "name": "Container",
      "category": "Layout"
    }
  ]
}
{% endschema %}

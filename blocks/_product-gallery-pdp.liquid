{% assign current_variant = product.selected_or_first_available_variant %}
{% assign current_color = current_variant.option1 %}
{% assign rendered_colors = '' %}

<script src="{{ 'carousel-component.js' | asset_url }}" type="module" fetchpriority="low"></script>
{{ 'carousel.css' | asset_url | stylesheet_tag }}

<div class="gallery-main-container">
  <div class="variant-carousels">
    {% for variant in product.variants %}
      {% assign color = variant.option1 %}

      {% unless rendered_colors contains color %}
        {% assign rendered_colors = rendered_colors | append: color | append: ',' %}
        {% assign color_gallery = null %}

        {% for v in product.variants %}
          {% if v.option1 == color and v.metafields.custom.gallery.value != blank %}
            {% assign color_gallery = v.metafields.custom.gallery.value %}
            {% break %}
          {% endif %}
        {% endfor %}

        <div
          class="variant-carousel"
          data-color="{{ color }}"
          {% unless color == current_color %}
            hidden
          {% endunless %}
        >
          <carousel-component
            columns-desktop="1"
            columns-mobile="1"
            gap="0"
            show-arrows="false"
            show-dots="true"
            thumbs-mobile="none"
            thumbs-desktop="right"
            show-thumbs-arrows="true"
            loop="true"
          >
            <div class="carousel-scroller-wrapper">
              <div role="list" class="carousel-scroller">
                {% if color_gallery %}
                  {% for image in color_gallery %}
                    <div role="listitem" class="carousel-slide">
                      <img
                        src="{{ image | image_url: width: 1500 }}"
                        alt="{{ product.title }} - {{ color }}"
                        loading="lazy"
                        width="1500"
                        height="1500"
                      >
                    </div>
                  {% endfor %}
                {% else %}
                  {% for media in product.media %}
                    {% if media.media_type == 'image' %}
                      <div role="listitem" class="carousel-slide">
                        <img
                          src="{{ media | image_url: width: 1500 }}"
                          alt="{{ product.title }}"
                          loading="lazy"
                          width="1500"
                          height="1500"
                        >
                      </div>
                    {% endif %}
                  {% endfor %}
                {% endif %}
              </div>

              <button type="button" name="previous" class="carousel-button prev" aria-label="Previous">
                {{ 'icon-chevron-left.svg' | inline_asset_content }}
              </button>
              <button type="button" name="next" class="carousel-button next" aria-label="Next">
                {{ 'icon-chevron-right.svg' | inline_asset_content }}
              </button>
            </div>

            <div class="carousel-thumbs">
              {% if color_gallery %}
                {% for image in color_gallery %}
                  <button
                    class="carousel-thumb"
                    aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  >
                    <img
                      src="{{ image | image_url: width: 150 }}"
                      alt="{{ product.title }} - {{ color }}"
                      loading="lazy"
                      width="150"
                      height="150"
                    >
                  </button>
                {% endfor %}
              {% else %}
                {% for media in product.media %}
                  {% if media.media_type == 'image' %}
                    <button
                      class="carousel-thumb"
                      aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                    >
                      <img
                        src="{{ media | image_url: width: 150 }}"
                        alt="{{ product.title }}"
                        loading="lazy"
                        width="150"
                        height="150"
                      >
                    </button>
                  {% endif %}
                {% endfor %}
              {% endif %}
            </div>
          </carousel-component>
        </div>
      {% endunless %}
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('variant:update', (event) => {
    const variant = event.detail?.resource;
    if (!variant) return;

    const color = variant.option1;
    document.querySelectorAll('.variant-carousel').forEach((block) => {
      block.hidden = block.dataset.color !== color;
    });
  });
</script>

{% schema %}
{
  "name": "Galería de Variantes",
  "tag": "section",
  "class": "section-variant-gallery",
  "settings": [
    {
      "type": "header",
      "content": "Ajustes de Zoom"
    },
    {
      "type": "checkbox",
      "id": "show_zoom_desktop",
      "label": "Mostrar botón de zoom en escritorio",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_zoom_mobile",
      "label": "Mostrar botón de zoom en móvil",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Galería de Variantes Personalizada"
    }
  ]
}
{% endschema %}

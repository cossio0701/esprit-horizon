{% liquid
  # Facade variables
  assign block_settings = block.settings
%}

<script
  type="module"
  src="{{ 'cart-icon.js' | asset_url }}"
  fetchpriority="low"
></script>

<div
  class="cart-block spacing-style"
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  {% liquid
    assign cart_type = section.settings.cart_type | default: settings.cart_type
  %}
  {% if cart_type == 'drawer' and template.name != 'cart' %}
    {% render 'cart-drawer', block: block %}
  {% else %}
    <a
      href="{{ routes.cart_url }}"
      class="header-actions__action action__cart"
      aria-label="{{ 'accessibility.cart' | t }}"
      aria-describedby="cart-bubble-text"
    >
      {% render 'cart-icon-component' %}
    </a>
  {% endif %}
</div>

{% stylesheet %}
  .cart-block {
    display: flex;
    align-items: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.cart",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.cart_features"
    },
    {
      "type": "select",
      "id": "cross_sell_source",
      "label": "t:settings.source",
      "options": [
        {
          "value": "recommendations",
          "label": "t:options.recommendations"
        },
        {
          "value": "collection",
          "label": "t:options.collection_source"
        }
      ],
      "default": "recommendations"
    },
    {
      "type": "collection",
      "id": "cross_sell_collection",
      "label": "t:settings.collection"
    },
    {
      "type": "select",
      "id": "cross_sell_recommendation_type",
      "label": "t:settings.recommendation_type",
      "options": [
        {
          "value": "complementary",
          "label": "t:options.complementary"
        },
        {
          "value": "related",
          "label": "t:options.related"
        }
      ],
      "default": "complementary"
    },
    {
      "type": "text",
      "id": "cross_sell_heading",
      "label": "t:settings.heading",
      "placeholder": "t:settings.cross_sell_heading"
    },
    {
      "type": "range",
      "id": "cross_sell_max_products",
      "label": "t:settings.product_count",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.cart"
    }
  ]
}
{% endschema %}

{% liquid
  # Facade variables
  assign block_settings = block.settings
%}

{% if shop.customer_accounts_enabled %}
  <div
    class="customer-account-block spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    {% render 'account-popover', settings: block_settings %}
    {% render 'account-drawer', settings: block_settings %}
  </div>
{% endif %}

{% stylesheet %}
  .customer-account-block {
    display: flex;
    align-items: center;
  }

  @media screen and (max-width: 989px) {
    .customer-account-block {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.customer_account",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.manage_customer_accounts"
    },
    {
      "type": "color_scheme",
      "id": "popover_color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.customer_account"
    }
  ]
}
{% endschema %}

{% liquid
  assign source = block.settings.source
  assign carousel_ref = 'productCarousel-' | append: block.id
  assign max_products = block.settings.max_products | default: 8

  # Settings for resource-list
  assign settings = block.settings
%}

<!-- [ProductCarousel Debug] Source: {{ source }}, Block ID: {{ block.id }} -->

<product-carousel
  id="ProductCarousel-{{ block.id }}"
  class="product-carousel"
  data-source="{{ source }}"
  data-collection-handle="{{ block.settings.carousel_collection.handle | default: 'all' }}"
  data-max-products="{{ max_products }}"
  data-sort-by="{{ block.settings.sort_by }}"
  data-section-id="{{ section.id }}"
  data-block-id="{{ block.id }}"
  {% if product %}
    data-product-id="{{ product.id }}"
  {% endif %}
  {% if request.visual_preview_mode %}
    data-shopify-editor-preview
  {% endif %}
>
  {% if block.settings.heading != blank or block.settings.view_all_link != blank %}
    <div class="product-carousel__header">
      {% if block.settings.heading != blank %}
        <h2 class="product-carousel__heading">
          {{ block.settings.heading }}
        </h2>
      {% endif %}
      {% if block.settings.view_all_link != blank %}
        <a href="{{ block.settings.view_all_link }}" class="product-carousel__view-all">
          {{ block.settings.view_all_label | default: 'Ver todo' }}
          <span class="view-all__icon">→</span>
        </a>
      {% endif %}
    </div>
  {% endif %}

  {% case source %}
    {% when 'collection' %}
      {% assign collection = block.settings.carousel_collection %}
      <!-- [ProductCarousel Debug] Collection Selected: {{ collection.title | default: 'None' }} -->
      {% if collection != blank %}
        {% liquid
          assign products = collection.products
          assign sorted_products = products
          case block.settings.sort_by
            when 'date_desc'
              assign sorted_products = products | sort: 'created_at' | reverse
            when 'date_asc'
              assign sorted_products = products | sort: 'created_at'
            when 'price_asc'
              assign sorted_products = products | sort: 'price'
            when 'price_desc'
              assign sorted_products = products | sort: 'price' | reverse
            when 'name_asc'
              assign sorted_products = products | sort: 'title'
            when 'discount_desc'
              assign sorted_products = products | sort: 'price'
          endcase
        %}
        <!-- [ProductCarousel Debug] Products Count: {{ sorted_products.size }} -->
        {% if sorted_products.size > 0 %}
          {% render 'product-carousel-items',
            products: sorted_products,
            max_products: max_products,
            settings: settings,
            carousel_ref: carousel_ref
          %}
        {% else %}
          <div class="product-carousel__placeholder">This collection has no products.</div>
        {% endif %}
      {% else %}
        {% comment %} Placeholder if no collection selected {% endcomment %}
        <div class="product-carousel__placeholder">{{ 'content.collection_placeholder' | t }}</div>
      {% endif %}

    {% when 'new_arrivals' %}
      {% liquid
        assign collection = block.settings.carousel_collection | default: collections.all
        assign products = collection.products | sort: 'created_at' | reverse
      %}
      <!-- [ProductCarousel Debug] New Arrivals Count: {{ products.size }} -->
      {% if products.size > 0 %}
        {% render 'product-carousel-items',
          products: products,
          max_products: max_products,
          settings: settings,
          carousel_ref: carousel_ref
        %}
      {% else %}
        <div class="product-carousel__placeholder">No new products available.</div>
      {% endif %}

    {% when 'best_sellers' %}
      {% liquid
        assign collection = block.settings.carousel_collection | default: collections.all
        assign products = collection.products | sort: 'best_selling'
      %}
      {% if products.size > 0 %}
        {% render 'product-carousel-items',
          products: products,
          max_products: max_products,
          settings: settings,
          carousel_ref: carousel_ref
        %}
      {% else %}
        <div class="product-carousel__loading" aria-label="{{ 'accessibility.loading_product_recommendations' | t }}">
          <div class="loading-spinner"></div>
        </div>
      {% endif %}

    {% when 'related' %}
      {% if recommendations.performed and recommendations.products_count > 0 %}
        {% render 'product-carousel-items',
          products: recommendations.products,
          max_products: max_products,
          settings: settings,
          carousel_ref: carousel_ref
        %}
      {% else %}
        {% liquid
          assign collection = block.settings.carousel_collection | default: collections.all
          assign products = collection.products | sort: 'best_selling'
        %}
        {% render 'product-carousel-items',
          products: products,
          max_products: max_products,
          settings: settings,
          carousel_ref: carousel_ref
        %}
      {% endif %}

    {% when 'recently_viewed' %}
      {% liquid
        assign viewed_products = search.results
        assign final_products = viewed_products

        if search.performed
          if viewed_products.size < max_products
            assign remaining_count = max_products | minus: viewed_products.size
            assign bs_collection = block.settings.carousel_collection | default: collections.all
            assign bs_candidates = bs_collection.products | sort: 'best_selling'
            assign supplementary_products = '' | split: ''

            for candidate in bs_candidates
              if supplementary_products.size >= remaining_count
                break
              endif

              assign is_duplicate = false
              for viewed in viewed_products
                if viewed.id == candidate.id
                  assign is_duplicate = true
                  break
                endif
              endfor

              unless is_duplicate
                assign candidate_arr = bs_collection.products | where: 'id', candidate.id
                assign supplementary_products = supplementary_products | concat: candidate_arr
              endunless
            endfor

            assign final_products = viewed_products | concat: supplementary_products
          endif
        else
          # First render or empty search: show Best Sellers as full fallback
          assign bs_collection = block.settings.carousel_collection | default: collections.all
          assign final_products = bs_collection.products | sort: 'best_selling'
        endif
      %}

      {% if final_products.size > 0 %}
        {% render 'product-carousel-items',
          products: final_products,
          max_products: max_products,
          settings: settings,
          carousel_ref: carousel_ref
        %}
      {% endif %}
  {% endcase %}
</product-carousel>

{% style %}
  #ProductCarousel-{{ block.id }} {
    display: block;
    width: 100%;
    min-height: 50px;
    --column-count: {{ block.settings.columns }};
    --column-count-mobile: {{ block.settings.mobile_columns | default: 1 }};

    padding-block-start: {{ block.settings.padding-block-start }}px;
    padding-block-end: {{ block.settings.padding-block-end }}px;
    padding-inline-start: {{ block.settings.padding-inline-start }}px;
    padding-inline-end: {{ block.settings.padding-inline-end }}px;
  }

  .product-carousel__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--gap-md, 20px);
    margin-block-end: var(--gap-md, 24px);
  }

  .product-carousel__heading {
    {% render 'typography-style', settings: block.settings, prefix: 'heading_' %}
    color: var(--color);
    font-family: var(--font-family);
    font-size: var(--font-size);
    font-weight: var(--font-weight);
    text-transform: var(--text-transform);
    line-height: var(--line-height);
    letter-spacing: var(--letter-spacing);
    margin: 0;
  }

  .product-carousel__view-all {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--color-foreground);
    font-size: var(--font-size--sm, 14px);
    transition: opacity 0.2s ease;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  .product-carousel__view-all:hover {
    opacity: 0.7;
  }

  .view-all__icon {
    font-size: 1.2em;
    line-height: 1;
  }

  @media screen and (max-width: 749px) {
    .product-carousel__heading {
      font-size: var(--font-size-mobile, var(--font-size));
    }
  }
  #ProductCarousel-{{ block.id }} .product-card-simple__title {
    {% render 'typography-style', settings: block.settings, prefix: 'title_' %}
    color: var(--color);
    font-family: var(--font-family);
    font-size: var(--font-size);
    font-weight: var(--font-weight);
    text-transform: var(--text-transform);
    line-height: var(--line-height);
    letter-spacing: var(--letter-spacing);
  }

  #ProductCarousel-{{ block.id }} :is(.product-card-simple__price-regular, .product-card-simple__price-sale, .product-card-simple__price-compare) {
    {% render 'typography-style', settings: block.settings, prefix: 'price_' %}
    color: var(--color);
    font-family: var(--font-family);
    font-size: var(--font-size);
    font-weight: var(--font-weight);
    text-transform: var(--text-transform);
    line-height: var(--line-height);
    letter-spacing: var(--letter-spacing);
  }

  @media screen and (max-width: 749px) {
    #ProductCarousel-{{ block.id }} .product-card-simple__title {
      font-size: var(--font-size-mobile, var(--font-size));
    }
    #ProductCarousel-{{ block.id }} :is(.product-card-simple__price-regular, .product-card-simple__price-sale, .product-card-simple__price-compare) {
      font-size: var(--font-size-mobile, var(--font-size));
    }
  }

  .product-carousel__placeholder {
    padding: 20px;
    text-align: center;
    background: rgba(0,0,0,0.05);
    border: 1px dashed rgba(0,0,0,0.2);
  }
{% endstyle %}


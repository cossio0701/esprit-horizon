{% assign breadcrumb_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .product-breadcrumb-{{ breadcrumb_id }} {
    margin-top: 0px;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .product-breadcrumb__container-{{ breadcrumb_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .product-breadcrumb__list-{{ breadcrumb_id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: {{ block.settings.item_spacing }}px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: {{ block.settings.font_size }}px;
    color: {{ block.settings.text_color }};
  }

  .product-breadcrumb__item-{{ breadcrumb_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.item_spacing }}px;
  }

  .product-breadcrumb__link-{{ breadcrumb_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .product-breadcrumb__link-{{ breadcrumb_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .product-breadcrumb__separator-{{ breadcrumb_id }} {
    color: {{ block.settings.separator_color }};
    font-size: {{ block.settings.font_size }}px;
  }

  .product-breadcrumb__active-{{ breadcrumb_id }} {
    color: #000000;
    font-weight: bold;
  }

  @media screen and (max-width: 749px) {
    .product-breadcrumb-{{ breadcrumb_id }} {
      margin-top: 0;
      padding: {{ block.settings.padding_top_mobile }}px 0 {{ block.settings.padding_bottom_mobile }}px;
    }

    .product-breadcrumb__list-{{ breadcrumb_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
    }

    .product-breadcrumb__separator-{{ breadcrumb_id }} {
      font-size: {{ block.settings.font_size_mobile }}px;
    }
  }
{% endstyle %}

<nav
  class="product-breadcrumb-{{ breadcrumb_id }}"
  aria-label="Breadcrumb"
  {{ block.shopify_attributes }}
>
  <div class="product-breadcrumb__container-{{ breadcrumb_id }}">
    <ol class="product-breadcrumb__list-{{ breadcrumb_id }}">
      <li class="product-breadcrumb__item-{{ breadcrumb_id }}">
        <a href="/" class="product-breadcrumb__link-{{ breadcrumb_id }}">
          {{ block.settings.home_text }}
        </a>
      </li>

      {% if product %}
        {% if product.collections.size > 0 %}
          <li class="product-breadcrumb__item-{{ breadcrumb_id }}" aria-hidden="true">
            <span class="product-breadcrumb__separator-{{ breadcrumb_id }}">/</span>
          </li>
          <li class="product-breadcrumb__item-{{ breadcrumb_id }}">
            <a href="{{ product.collections.first.url }}" class="product-breadcrumb__link-{{ breadcrumb_id }}">
              {{ product.collections.first.title }}
            </a>
          </li>
        {% endif %}

        <li class="product-breadcrumb__item-{{ breadcrumb_id }}" aria-hidden="true">
          <span class="product-breadcrumb__separator-{{ breadcrumb_id }}">/</span>
        </li>
        <li class="product-breadcrumb__item-{{ breadcrumb_id }}">
          {% if product.metafields.custom.product_category != blank %}
            <span class="product-breadcrumb__active-{{ breadcrumb_id }}">
              {{ product.metafields.custom.product_category }}
            </span>
          {% else %}
            <span class="product-breadcrumb__active-{{ breadcrumb_id }}">
              {{ product.title }}
            </span>
          {% endif %}
        </li>
      {% elsif collection %}
        <li class="product-breadcrumb__item-{{ breadcrumb_id }}" aria-hidden="true">
          <span class="product-breadcrumb__separator-{{ breadcrumb_id }}">/</span>
        </li>
        <li class="product-breadcrumb__item-{{ breadcrumb_id }}">
          <span class="product-breadcrumb__active-{{ breadcrumb_id }}">
            {{ collection.title }}
          </span>
        </li>
      {% elsif page %}
        <li class="product-breadcrumb__item-{{ breadcrumb_id }}" aria-hidden="true">
          <span class="product-breadcrumb__separator-{{ breadcrumb_id }}">/</span>
        </li>
        <li class="product-breadcrumb__item-{{ breadcrumb_id }}">
          <span class="product-breadcrumb__active-{{ breadcrumb_id }}">
            {{ page.title }}
          </span>
        </li>
      {% endif %}
    </ol>
  </div>
</nav>

{% schema %}
{
  "name": "Product Breadcrumb",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "home_text",
      "label": "Home text",
      "default": "Inicio"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "item_spacing",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Item spacing",
      "default": 8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator",
      "default": "#999999"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Product breadcrumb"
    }
  ]
}
{% endschema %}

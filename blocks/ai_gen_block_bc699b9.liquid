{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
  }

  .ai-footer-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    max-width: 100%;
    gap: {{ block.settings.spacing_between_blocks }}px;
  }

  .ai-footer-left-section-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.spacing_between_blocks }}px;
  }

  .ai-footer-left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex-shrink: 0;
  }

  .ai-footer-left-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.4;
    margin: 0;
  }

  .ai-footer-center-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .ai-footer-center-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  .ai-footer-center-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-footer-center-text-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ai-footer-center-text-line-{{ ai_gen_id }} {
    font-size: {{ block.settings.center_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.2;
    margin: 0;
  }

  .ai-footer-copyright-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    white-space: nowrap;
    text-align: center;
    justify-self: center;
  }

  .ai-footer-social-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.social_spacing }}px;
    justify-self: end;
  }

  .ai-footer-social-link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.social_icon_size }}px;
    height: {{ block.settings.social_icon_size }}px;
    color: {{ block.settings.social_icon_color }};
    transition: color 0.3s ease;
  }

  .ai-footer-social-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.social_icon_hover_color }};
  }

  .ai-footer-social-link-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 767px) {
    .ai-footer-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .ai-footer-left-section-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 24px;
      order: 2;
    }

    .ai-footer-left-{{ ai_gen_id }} {
      align-items: center;
    }

    .ai-footer-center-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 8px;
    }

    .ai-footer-center-text-{{ ai_gen_id }} {
      align-items: center;
    }

    .ai-footer-copyright-{{ ai_gen_id }} {
      order: 3;
    }

    .ai-footer-social-{{ ai_gen_id }} {
      order: 1;
      justify-self: center;
    }
  }
{% endstyle %}

<footer-block-{{ ai_gen_id }} class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-container-{{ ai_gen_id }}">
    <div class="ai-footer-left-section-{{ ai_gen_id }}">
      <div class="ai-footer-left-{{ ai_gen_id }}">
        <div class="ai-footer-left-text-{{ ai_gen_id }}">{{ block.settings.company_line_1 }}</div>
        <div class="ai-footer-left-text-{{ ai_gen_id }}">{{ block.settings.company_line_2 }}</div>
      </div>

      <div class="ai-footer-center-{{ ai_gen_id }}">
        {% if block.settings.center_icon %}
          <div class="ai-footer-center-icon-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.center_icon | image_url: width: 200 }}"
              alt="{{ block.settings.center_icon.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.icon_size }}"
              height="{{ block.settings.icon_size }}"
            >
          </div>
        {% endif %}
        <div class="ai-footer-center-text-{{ ai_gen_id }}">
          <div class="ai-footer-center-text-line-{{ ai_gen_id }}">{{ block.settings.center_line_1 }}</div>
          <div class="ai-footer-center-text-line-{{ ai_gen_id }}">{{ block.settings.center_line_2 }}</div>
        </div>
      </div>
    </div>

    <div class="ai-footer-copyright-{{ ai_gen_id }}">{{ block.settings.copyright_text }}</div>

    <div class="ai-footer-social-{{ ai_gen_id }}">
      {% if block.settings.instagram_url != blank %}
        <a
          href="{{ block.settings.instagram_url }}"
          class="ai-footer-social-link-{{ ai_gen_id }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
      {% endif %}

      {% if block.settings.tiktok_url != blank %}
        <a
          href="{{ block.settings.tiktok_url }}"
          class="ai-footer-social-link-{{ ai_gen_id }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="TikTok"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
          </svg>
        </a>
      {% endif %}

      {% if block.settings.facebook_url != blank %}
        <a
          href="{{ block.settings.facebook_url }}"
          class="ai-footer-social-link-{{ ai_gen_id }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
        </a>
      {% endif %}

      {% if block.settings.pinterest_url != blank %}
        <a
          href="{{ block.settings.pinterest_url }}"
          class="ai-footer-social-link-{{ ai_gen_id }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Pinterest"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/>
          </svg>
        </a>
      {% endif %}

      {% if block.settings.youtube_url != blank %}
        <a
          href="{{ block.settings.youtube_url }}"
          class="ai-footer-social-link-{{ ai_gen_id }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="YouTube"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
            <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
          </svg>
        </a>
      {% endif %}

      {% if block.settings.linkedin_url != blank %}
        <a
          href="{{ block.settings.linkedin_url }}"
          class="ai-footer-social-link-{{ ai_gen_id }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
      {% endif %}

      {% if block.settings.whatsapp_url != blank %}
        <a
          href="{{ block.settings.whatsapp_url }}"
          class="ai-footer-social-link-{{ ai_gen_id }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>
</footer-block-{{ ai_gen_id }}>

<script>
  (function() {
    class FooterBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('footer-block-{{ ai_gen_id }}', FooterBlock{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Footer layout",
  "settings": [
    {
      "type": "header",
      "content": "Company information"
    },
    {
      "type": "richtext",
      "id": "company_line_1",
      "label": "Company line 1",
      "default": "<p>COMODÍN S.A.S / NIT:800069933-6</p>"
    },
    {
      "type": "richtext",
      "id": "company_line_2",
      "label": "Company line 2",
      "default": "<p>Calle 14 # 52 A 37 Medellín, Colombia</p>"
    },
    {
      "type": "header",
      "content": "Institutional block"
    },
    {
      "type": "image_picker",
      "id": "center_icon",
      "label": "Icon"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 20,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "richtext",
      "id": "center_line_1",
      "label": "Line 1",
      "default": "<p>Industry and Commerce</p>"
    },
    {
      "type": "richtext",
      "id": "center_line_2",
      "label": "Line 2",
      "default": "<p>Superintendence</p>"
    },
    {
      "type": "range",
      "id": "center_text_size",
      "label": "Text size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "richtext",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "<p>© 2025 ESPRIT, all rights reserved</p>"
    },
    {
      "type": "header",
      "content": "Social media"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn URL"
    },
    {
      "type": "url",
      "id": "whatsapp_url",
      "label": "WhatsApp URL"
    },
    {
      "type": "range",
      "id": "social_icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "social_spacing",
      "label": "Icon spacing",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "social_icon_color",
      "label": "Social icon color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "social_icon_hover_color",
      "label": "Social icon hover color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "spacing_between_blocks",
      "label": "Spacing between blocks",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Footer layout"
    }
  ],
  "tag": null
}
{% endschema %}
            "text_TXVpkp": {
              "type": "text",
              "name": "t:names.text",
              "settings": {
                "text": "<p>Comprar en Esprit es muy f\u00e1cil, s\u00f3lo debes seguir los siguientes pasos:</p>",
                "enable_collapse": false,
